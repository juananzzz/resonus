index 0000000000000000000000000000000000000000..7e949bf2fb325d00f0ae39ce158d5365de15228a
--- /dev/null
+++ b/ios/AnimatedArtwork.swift
@@ -0,0 +1,702 @@
+import AVFoundation
+import CoreGraphics
+import CoreImage
+import CoreMedia
+import CoreVideo
+import CryptoKit
+import Foundation
+import ImageIO
+import MediaPlayer
+import UIKit
+
+#if compiler(>=6.2)
+
+@available(iOS 26.0, tvOS 26.0, *)
+final class AnimatedArtwork {
+  private static let maxSide = 720
+  // 900 frames is 30 fps across the whole 29 seconds, so this cap only bites
+  // on content that could not have been carried at full rate anyway.
+  private static let maxFrames = 900
+  // The frame-rate ceiling, and the system's own limit above it (Apple,
+  // "Providing animated artwork for media items": not above 60 fps). The cap
+  // is 30 by default — half the frames to decode and to encode, for a cover
+  // that reads the same — and Settings rewrites it through
+  // `AudioModule.setArtworkFps`.
+  private static let rateLock = NSLock()
+  private static var rateCap = 30.0
+  static var maxPlaybackRate: Double {
+    get {
+      rateLock.lock()
+      defer { rateLock.unlock() }
+      return rateCap
+    }
+    set {
+      rateLock.lock()
+      defer { rateLock.unlock() }
+      rateCap = newValue
+    }
+  }
+  // The system prefers a clip that is *less than* 30 seconds, so stop at 29.
+  private static let maxDuration = 29.0
+  private static let minFrameDelay = 1.0 / 60.0
+  private static let fallbackDelay = 0.1
+  private static let browserDelayFloor = 0.011
+  private static let frameOptions = [kCGImageSourceShouldCache: false] as CFDictionary
+  private static let blurContext = CIContext()
+  private static let deviceRGB = CGColorSpaceCreateDeviceRGB()
+
+  /// One encode per destination, shared by every instance holding the same
+  /// clip: an evicted and refetched cover joins the task already writing its
+  /// file instead of racing a second encoder at the same path.
+  private static let sharedTaskLock = NSLock()
+  private static var sharedTasks: [String: Task<URL?, Never>] = [:]
+
+  private enum Ratio {
+    case square
+    case tall
+
+    var suffix: String {
+      switch self {
+      case .square:
+        return "1x1"
+      case .tall:
+        return "3x4"
+      }
+    }
+  }
+
+  private struct Sample {
+    let index: Int
+    let time: Double
+  }
+
+  private struct Schedule {
+    let samples: [Sample]
+    let total: Double
+  }
+
+  private let artworkID: String
+  private let ratio: Ratio
+  private let sourceSize: CGSize
+  private let destination: URL
+  private var data: Data?
+  private let lock = NSLock()
+  private var encodeTask: Task<URL?, Never>?
+
+  /// The object the lock screen is handed, built out of this clip. What
+  /// carries it is the file behind it, so the caller publishes it only once
+  /// `isOnDisk` and never before.
+  private(set) var item: MPMediaItemAnimatedArtwork?
+
+  /// The clip is written out: the system opens it the moment it is asked for
+  /// it. Named for the file, not for the encoding, which has a method of its
+  /// own called `isReady`.
+  var isOnDisk: Bool {
+    FileManager.default.fileExists(atPath: destination.path)
+  }
+
+  /// Calls `onReady` from the task that wrote the clip, once it is on disk
+  /// (right away when it already was). Encoding starts here instead of on the
+  /// system's request: that request arrives with the artwork itself, and one
+  /// answered after the wait left the lock screen on the preview frame — the
+  /// clip was ready all along, nothing told the system to ask again.
+  func whenReady(_ onReady: @escaping () -> Void) {
+    // `.userInitiated`, not `.utility`: this runs when the lock screen is
+    // waiting for the clip, often with the phone locked — the one moment
+    // `.utility` gets almost no CPU.
+    Task.detached(priority: .userInitiated) {
+      _ = await self.videoURL()
+      onReady()
+    }
+  }
+
+  /// The clips the system can ask for: the tall one only. It is the key the
+  /// iPhone lock screen draws full screen, and providing only `1x1` left that
+  /// screen with the static artwork — the square variant that used to be
+  /// built beside it is gone now, which halves the encode and leaves the
+  /// system to show its static cover wherever it would have asked for `1x1`.
+  static func make(url: URL, data: Data) -> (square: AnimatedArtwork?, tall: AnimatedArtwork?) {
+    guard let source = CGImageSourceCreateWithData(data as CFData, nil),
+          CGImageSourceGetCount(source) > 1,
+          let properties = CGImageSourceCopyPropertiesAtIndex(source, 0, nil) as? [String: Any]
+    else {
+      return (nil, nil)
+    }
+    let width = (properties[kCGImagePropertyPixelWidth as String] as? NSNumber)?.intValue ?? 0
+    let height = (properties[kCGImagePropertyPixelHeight as String] as? NSNumber)?.intValue ?? 0
+    guard width > 0, height > 0,
+          let frame = CGImageSourceCreateImageAtIndex(source, 0, frameOptions)
+    else {
+      return (nil, nil)
+    }
+    let sourceSize = CGSize(width: width, height: height)
+    let id = identifier(for: url)
+    let tall = variant(id: id, ratio: .tall, sourceSize: sourceSize, frame: frame, url: url, data: data)
+    return (square: nil, tall: tall)
+  }
+
+  private static func variant(
+    id: String,
+    ratio: Ratio,
+    sourceSize: CGSize,
+    frame: CGImage,
+    url: URL,
+    data: Data
+  ) -> AnimatedArtwork? {
+    guard let destination = cacheFile(id: id, ratio: ratio) else {
+      return nil
+    }
+    let artwork = AnimatedArtwork(
+      artworkID: id + "-" + ratio.suffix,
+      ratio: ratio,
+      sourceSize: sourceSize,
+      destination: destination,
+      data: data
+    )
+    let preview = artwork.previewFrame(frame)
+    artwork.item = MPMediaItemAnimatedArtwork(
+      artworkID: artwork.artworkID,
+      previewImageRequestHandler: { _ in preview },
+      videoAssetFileURLRequestHandler: { _ in await artwork.videoURL() }
+    )
+    return artwork
+  }
+
+  private init(artworkID: String, ratio: Ratio, sourceSize: CGSize, destination: URL, data: Data) {
+    self.artworkID = artworkID
+    self.ratio = ratio
+    self.sourceSize = sourceSize
+    self.destination = destination
+    self.data = data
+  }
+
+  private var canvas: CGSize {
+    let longest = max(Int(sourceSize.width), Int(sourceSize.height))
+    let side = Self.evenSide(longest: longest)
+    switch ratio {
+    case .square:
+      return CGSize(width: side, height: side)
+    case .tall:
+      // A multiple of 6 keeps both edges even and makes 3:4 exact, which the
+      // system checks the same way it checks the preview.
+      let width = max(6, side - (side % 6))
+      return CGSize(width: width, height: width * 4 / 3)
+    }
+  }
+
+  /// The preview is built with the variant's aspect ratio from the first
+  /// frame: a preview that does not match the key makes the system drop the
+  /// animated artwork and fall back to the static one. It is composed the
+  /// same way the clip's frames are — same sized backdrop, same feather
+  /// mask — so the two cannot drift apart.
+  private func previewFrame(_ frame: CGImage) -> UIImage {
+    let size = canvas
+    let format = UIGraphicsImageRendererFormat()
+    format.scale = 1
+    // Not opaque: the composition leans on alpha while it builds, and the
+    // backdrop underneath makes the result opaque anyway.
+    format.opaque = false
+    var backdrop: CGImage? = nil
+    var mask: CGImage? = nil
+    if ratio == .tall {
+      backdrop = Self.blurred(frame).flatMap { Self.sized($0, to: size) }
+      mask = Self.featherMask(size: Self.artRect(in: size).size)
+    }
+    return UIGraphicsImageRenderer(size: size, format: format).image { renderer in
+      let context = renderer.cgContext
+      // UIKit contexts are flipped, so a CGImage drawn straight comes out
+      // upside down — that is what the lock screen showed while the video
+      // was still encoding.
+      context.saveGState()
+      context.translateBy(x: 0, y: size.height)
+      context.scaleBy(x: 1, y: -1)
+      draw(frame, in: context, canvas: size, backdrop: backdrop, mask: mask)
+      context.restoreGState()
+    }
+  }
+
+  /// The square the cover sits in on the tall canvas, centred on it.
+  private static func artRect(in canvas: CGSize) -> CGRect {
+    let side = min(canvas.width, canvas.height)
+    return CGRect(x: 0, y: (canvas.height - side) / 2, width: side, height: side)
+  }
+
+  private func draw(
+    _ frame: CGImage,
+    in context: CGContext,
+    canvas: CGSize,
+    backdrop: CGImage?,
+    mask: CGImage?
+  ) {
+    let bounds = CGRect(origin: .zero, size: canvas)
+    context.interpolationQuality = .high
+    guard ratio == .tall, let backdrop else {
+      context.setFillColor(red: 0, green: 0, blue: 0, alpha: 1)
+      context.fill(bounds)
+      context.draw(frame, in: bounds)
+      return
+    }
+    let art = Self.artRect(in: canvas)
+    guard let mask else {
+      // Only when the mask could not be built: the feather is the point of
+      // the composition, but a cover without it still reads.
+      context.setFillColor(red: 0, green: 0, blue: 0, alpha: 1)
+      context.fill(bounds)
+      context.draw(backdrop, in: bounds)
+      context.draw(frame, in: art)
+      return
+    }
+    // Composed in this one context with nothing allocated per frame: the
+    // cover in the art square, its alpha trimmed by the mask, the backdrop
+    // slipped underneath — which lands on backdrop * (1 - mask) + cover *
+    // mask, the feathered edges melting into the blur. The backdrop is
+    // already sized to the canvas, so every draw here is a blit.
+    context.clear(bounds)
+    context.draw(frame, in: art)
+    context.setBlendMode(.destinationIn)
+    context.draw(mask, in: art)
+    context.setBlendMode(.destinationOver)
+    context.draw(backdrop, in: bounds)
+    context.setBlendMode(.normal)
+  }
+
+  /// The backdrop at canvas size, aspect-filled: scaled once per clip here,
+  /// rather than a high-quality scale per frame of the encode.
+  private static func sized(_ image: CGImage, to canvas: CGSize) -> CGImage? {
+    let width = Int(canvas.width)
+    let height = Int(canvas.height)
+    guard width > 0, height > 0,
+          let context = CGContext(
+            data: nil,
+            width: width,
+            height: height,
+            bitsPerComponent: 8,
+            bytesPerRow: 0,
+            space: deviceRGB,
+            bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
+          )
+    else {
+      return nil
+    }
+    context.interpolationQuality = .high
+    context.setFillColor(red: 0, green: 0, blue: 0, alpha: 1)
+    context.fill(CGRect(x: 0, y: 0, width: canvas.width, height: canvas.height))
+    let source = CGSize(width: image.width, height: image.height)
+    context.draw(image, in: aspectFill(source, in: CGRect(origin: .zero, size: canvas)))
+    return context.makeImage()
+  }
+
+  /// The feather itself: white, transparent at both edges and solid through
+  /// the middle — the same gradient `drawFeathered` used to build on every
+  /// single frame, now built once per clip.
+  private static func featherMask(size: CGSize) -> CGImage? {
+    let width = Int(size.width)
+    let height = Int(size.height)
+    guard width > 4, height > 4,
+          let context = CGContext(
+            data: nil,
+            width: width,
+            height: height,
+            bitsPerComponent: 8,
+            bytesPerRow: 0,
+            space: deviceRGB,
+            bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
+          )
+    else {
+      return nil
+    }
+    let colors = [
+      UIColor.white.withAlphaComponent(0).cgColor,
+      UIColor.white.cgColor,
+      UIColor.white.cgColor,
+      UIColor.white.withAlphaComponent(0).cgColor,
+    ] as CFArray
+    let locations: [CGFloat] = [0, 0.16, 0.84, 1]
+    guard let gradient = CGGradient(colorsSpace: deviceRGB, colors: colors, locations: locations) else {
+      return nil
+    }
+    context.drawLinearGradient(
+      gradient,
+      start: CGPoint(x: 0, y: 0),
+      end: CGPoint(x: 0, y: size.height),
+      options: []
+    )
+    return context.makeImage()
+  }
+
+  private static func blurred(_ frame: CGImage) -> CGImage? {
+    let input = CIImage(cgImage: frame)
+    let extent = input.extent
+    guard extent.width > 1, extent.height > 1, !extent.isInfinite, !extent.isNull else {
+      return downscaleBlur(frame)
+    }
+    guard let filter = CIFilter(name: "CIGaussianBlur") else {
+      return downscaleBlur(frame)
+    }
+    // A gaussian blur samples outside the picture, and into nothing: the outer
+    // band of the backdrop comes out see-through, which is exactly where the
+    // cover's own edge was still readable. The clamp repeats the border pixel
+    // instead, so the backdrop stays solid all the way out and the radius alone
+    // decides how soft it reads.
+    let clamped = input.applyingFilter(
+      "CIAffineClamp",
+      parameters: ["inputTransform": NSValue(cgAffineTransform: .identity)]
+    )
+    filter.setValue(clamped, forKey: kCIInputImageKey)
+    filter.setValue(96.0, forKey: kCIInputRadiusKey)
+    guard let output = filter.outputImage?.cropped(to: extent),
+          let image = blurContext.createCGImage(output, from: extent)
+    else {
+      return downscaleBlur(frame)
+    }
+    return image
+  }
+
+  /// Blur without CoreImage: shrink the frame to a few pixels and scale it
+  /// back up, so the bands around the cover always come out soft even when
+  /// the gaussian filter refuses the image.
+  private static func downscaleBlur(_ frame: CGImage) -> CGImage? {
+    let width = 16
+    let height = max(1, Int((CGFloat(width) * CGFloat(frame.height) / CGFloat(max(1, frame.width))).rounded()))
+    guard let context = CGContext(
+      data: nil,
+      width: width,
+      height: height,
+      bitsPerComponent: 8,
+      bytesPerRow: 0,
+      space: CGColorSpaceCreateDeviceRGB(),
+      bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
+    ) else {
+      return nil
+    }
+    context.interpolationQuality = .high
+    context.draw(frame, in: CGRect(x: 0, y: 0, width: CGFloat(width), height: CGFloat(height)))
+    return context.makeImage()
+  }
+
+  private static func aspectFill(_ size: CGSize, in bounds: CGRect) -> CGRect {
+    guard size.width > 0, size.height > 0 else {
+      return bounds
+    }
+    let scale = max(bounds.width / size.width, bounds.height / size.height)
+    let width = size.width * scale
+    let height = size.height * scale
+    return CGRect(x: bounds.midX - width / 2, y: bounds.midY - height / 2, width: width, height: height)
+  }
+
+  private func videoURL() async -> URL? {
+    if FileManager.default.fileExists(atPath: destination.path) {
+      return destination
+    }
+    return await encodeTaskValue().value
+  }
+
+  private func encodeTaskValue() -> Task<URL?, Never> {
+    lock.lock()
+    if let encodeTask {
+      lock.unlock()
+      return encodeTask
+    }
+    lock.unlock()
+    // One task per destination across instances: a second instance holding
+    // the same clip joins the encode already running rather than starting a
+    // rival writer at the same path.
+    Self.sharedTaskLock.lock()
+    if let shared = Self.sharedTasks[destination.path] {
+      Self.sharedTaskLock.unlock()
+      lock.lock()
+      encodeTask = shared
+      lock.unlock()
+      return shared
+    }
+    // `.userInitiated`: the lock screen is waiting on this file, often with
+    // the phone locked, where `.utility` would crawl.
+    let created = Task.detached(priority: .userInitiated) {
+      await self.encode()
+    }
+    Self.sharedTasks[destination.path] = created
+    Self.sharedTaskLock.unlock()
+    lock.lock()
+    encodeTask = created
+    lock.unlock()
+    let path = destination.path
+    Task {
+      _ = await created.value
+      Self.sharedTaskLock.lock()
+      Self.sharedTasks.removeValue(forKey: path)
+      Self.sharedTaskLock.unlock()
+    }
+    return created
+  }
+
+  private func encode() async -> URL? {
+    defer {
+      lock.lock()
+      data = nil
+      lock.unlock()
+    }
+    if FileManager.default.fileExists(atPath: destination.path) {
+      return destination
+    }
+    lock.lock()
+    let data = self.data
+    lock.unlock()
+    guard let data, let source = CGImageSourceCreateWithData(data as CFData, nil) else {
+      return nil
+    }
+    guard let schedule = Self.schedule(source: source, count: CGImageSourceGetCount(source)) else {
+      return nil
+    }
+    return await write(source: source, schedule: schedule)
+  }
+
+  private func write(source: CGImageSource, schedule: Schedule) async -> URL? {
+    let fileManager = FileManager.default
+    guard !fileManager.fileExists(atPath: destination.path) else {
+      return destination
+    }
+    let directory = destination.deletingLastPathComponent()
+    try? fileManager.createDirectory(at: directory, withIntermediateDirectories: true)
+    let temporary = directory.appendingPathComponent("tmp-" + UUID().uuidString + ".mp4")
+    defer {
+      if fileManager.fileExists(atPath: temporary.path) {
+        try? fileManager.removeItem(at: temporary)
+      }
+    }
+
+    let canvas = self.canvas
+    let width = Int(canvas.width)
+    let height = Int(canvas.height)
+    // What the rate controller is told to expect: without it the encoder
+    // budgets for a frame rate that has nothing to do with the samples being
+    // appended, and spends the bits it has on the wrong thing.
+    let outputRate = Double(schedule.samples.count) / max(schedule.total, 0.001)
+    let expectedFrameRate = Int(min(Self.maxPlaybackRate, max(1, outputRate.rounded())))
+    let settings: [String: Any] = [
+      AVVideoCodecKey: AVVideoCodecType.h264,
+      AVVideoWidthKey: width,
+      AVVideoHeightKey: height,
+      AVVideoCompressionPropertiesKey: [
+        AVVideoAverageBitRateKey: width * height * 2,
+        AVVideoMaxKeyFrameIntervalKey: 30,
+        AVVideoExpectedSourceFrameRateKey: expectedFrameRate,
+        AVVideoAllowFrameReorderingKey: false,
+      ] as [String: Any],
+    ]
+    guard let writer = try? AVAssetWriter(outputURL: temporary, fileType: .mp4) else {
+      return nil
+    }
+    let input = AVAssetWriterInput(mediaType: .video, outputSettings: settings)
+    input.expectsMediaDataInRealTime = false
+    guard writer.canAdd(input) else {
+      return nil
+    }
+    writer.add(input)
+    let adaptor = AVAssetWriterInputPixelBufferAdaptor(
+      assetWriterInput: input,
+      sourcePixelBufferAttributes: [
+        kCVPixelBufferPixelFormatTypeKey as String: kCVPixelFormatType_32BGRA,
+        kCVPixelBufferWidthKey as String: width,
+        kCVPixelBufferHeightKey as String: height,
+        kCVPixelBufferCGImageCompatibilityKey as String: true,
+        kCVPixelBufferCGBitmapContextCompatibilityKey as String: true,
+      ]
+    )
+    guard writer.startWriting() else {
+      return nil
+    }
+    writer.startSession(atSourceTime: .zero)
+    defer {
+      if writer.status == .writing {
+        writer.cancelWriting()
+      }
+    }
+
+    // Both composed once per clip: the blurred backdrop scaled to the canvas
+    // (every frame then draws it as a blit, with no aspect-fill math and no
+    // high-quality scale per frame), and the feather mask that trims the
+    // cover's top and bottom edges.
+    let backdrop: CGImage?
+    let mask: CGImage?
+    if ratio == .tall,
+       let first = CGImageSourceCreateImageAtIndex(source, 0, Self.frameOptions),
+       let blurred = Self.blurred(first) {
+      backdrop = Self.sized(blurred, to: canvas)
+      mask = Self.featherMask(size: Self.artRect(in: canvas).size)
+    } else {
+      backdrop = nil
+      mask = nil
+    }
+
+    for sample in schedule.samples {
+      guard let frame = CGImageSourceCreateImageAtIndex(source, sample.index, Self.frameOptions),
+            let buffer = pixelBuffer(adaptor: adaptor, frame: frame, canvas: canvas, backdrop: backdrop, mask: mask),
+            await isReady(input, writer: writer),
+            adaptor.append(buffer, withPresentationTime: CMTime(seconds: sample.time, preferredTimescale: 600))
+      else {
+        return nil
+      }
+    }
+
+    guard let lastIndex = schedule.samples.last?.index,
+          let lastFrame = CGImageSourceCreateImageAtIndex(source, lastIndex, Self.frameOptions),
+          let lastBuffer = pixelBuffer(adaptor: adaptor, frame: lastFrame, canvas: canvas, backdrop: backdrop, mask: mask),
+          await isReady(input, writer: writer)
+    else {
+      return nil
+    }
+    guard adaptor.append(lastBuffer, withPresentationTime: CMTime(seconds: schedule.total, preferredTimescale: 600)) else {
+      return nil
+    }
+
+    input.markAsFinished()
+    await withCheckedContinuation { (continuation: CheckedContinuation<Void, Never>) in
+      writer.finishWriting {
+        continuation.resume()
+      }
+    }
+    guard writer.status == .completed else {
+      return nil
+    }
+
+    do {
+      try fileManager.moveItem(at: temporary, to: destination)
+    } catch {
+      return fileManager.fileExists(atPath: destination.path) ? destination : nil
+    }
+    return destination
+  }
+
+  private func isReady(_ input: AVAssetWriterInput, writer: AVAssetWriter) async -> Bool {
+    while !input.isReadyForMoreMediaData {
+      if writer.status != .writing {
+        return false
+      }
+      try? await Task.sleep(nanoseconds: 4_000_000)
+    }
+    return true
+  }
+
+  private func pixelBuffer(
+    adaptor: AVAssetWriterInputPixelBufferAdaptor,
+    frame: CGImage,
+    canvas: CGSize,
+    backdrop: CGImage?,
+    mask: CGImage?
+  ) -> CVPixelBuffer? {
+    guard let pool = adaptor.pixelBufferPool else {
+      return nil
+    }
+    var created: CVPixelBuffer?
+    guard CVPixelBufferPoolCreatePixelBuffer(kCFAllocatorDefault, pool, &created) == kCVReturnSuccess,
+          let buffer = created
+    else {
+      return nil
+    }
+    CVPixelBufferLockBaseAddress(buffer, [])
+    defer { CVPixelBufferUnlockBaseAddress(buffer, []) }
+    guard let context = CGContext(
+      data: CVPixelBufferGetBaseAddress(buffer),
+      width: Int(canvas.width),
+      height: Int(canvas.height),
+      bitsPerComponent: 8,
+      bytesPerRow: CVPixelBufferGetBytesPerRow(buffer),
+      space: Self.deviceRGB,
+      bitmapInfo: CGImageAlphaInfo.premultipliedFirst.rawValue | CGBitmapInfo.byteOrder32Little.rawValue
+    ) else {
+      return nil
+    }
+    draw(frame, in: context, canvas: canvas, backdrop: backdrop, mask: mask)
+    return buffer
+  }
+
+  private static func schedule(source: CGImageSource, count: Int) -> Schedule? {
+    let delays = (0..<count).map { frameDelay(at: $0, source: source) }
+    let span = delays.reduce(0, +)
+    // Frames are dropped for one of two reasons and no other: the clip runs
+    // faster than the system will show it, or there are more frames than the
+    // encoder should carry. Counting alone was a third reason, and it was the
+    // one that showed: a cover long enough to fill the 29 seconds at 30 fps is
+    // 870 frames, which came out as every third one, so the lock screen showed
+    // 10 fps of a clip the app beside it was playing at 30. Length is not a
+    // reason to drop frames, only to cut the tail, which the clamp below does.
+    var step = 1
+    if span > 0 {
+      step = max(step, Int(((Double(count) / span) / maxPlaybackRate).rounded(.up)))
+    }
+    step = max(step, Int((Double(count) / Double(maxFrames)).rounded(.up)))
+    var samples: [Sample] = []
+    var time = 0.0
+    var index = 0
+    while index < count {
+      var delay = 0.0
+      var cursor = index
+      let end = min(index + step, count)
+      while cursor < end {
+        delay += delays[cursor]
+        cursor += 1
+      }
+      if time + delay > maxDuration {
+        delay = maxDuration - time
+      }
+      guard delay > 0 else {
+        break
+      }
+      samples.append(Sample(index: index, time: time))
+      time += delay
+      if time >= maxDuration {
+        break
+      }
+      index += step
+    }
+    guard !samples.isEmpty else {
+      return nil
+    }
+    return Schedule(samples: samples, total: time)
+  }
+
+  private static func frameDelay(at index: Int, source: CGImageSource) -> Double {
+    guard let properties = CGImageSourceCopyPropertiesAtIndex(source, index, nil) as? [String: Any] else {
+      return fallbackDelay
+    }
+    // The per-frame delays live in a format sub-dictionary whose key is
+    // "{WebP}"/"{GIF}"/"{PNG}", not "WebP": looking for the unbraced name
+    // never matched, so every frame fell back to 100ms and the cover crawled
+    // at ten frames per second. Any sub-dictionary carrying a delay wins.
+    for value in properties.values {
+      guard let dictionary = value as? [String: Any] else {
+        continue
+      }
+      let unclamped = (dictionary["UnclampedDelayTime"] as? NSNumber)?.doubleValue ?? 0
+      let clamped = (dictionary["DelayTime"] as? NSNumber)?.doubleValue ?? 0
+      let delay = unclamped > 0 ? unclamped : clamped
+      guard delay > 0 else {
+        continue
+      }
+      return delay < browserDelayFloor ? fallbackDelay : max(delay, minFrameDelay)
+    }
+    return fallbackDelay
+  }
+
+  private static func evenSide(longest: Int) -> Int {
+    let capped = min(maxSide, longest)
+    return max(2, capped - (capped % 2))
+  }
+
+  private static func identifier(for url: URL) -> String {
+    SHA256.hash(data: Data(url.absoluteString.utf8))
+      .map { String(format: "%02x", $0) }
+      .joined()
+  }
+
+  private static func cacheFile(id: String, ratio: Ratio) -> URL? {
+    guard let base = FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask).first else {
+      return nil
+    }
+    return base
+      .appendingPathComponent("animated-artwork", isDirectory: true)
+      .appendingPathComponent(id + "-" + ratio.suffix + ".mp4")
+  }
+}
+
+#endif
