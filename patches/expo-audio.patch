+
+  // What the player itself does not know stays unknown: shifting -1, or
+  // `TIME_UNSET`, by the offset would invent an answer.
+  private fun shifted(ms: Long): Long = if (ms < 0) ms else ms + positionOffsetMs()
+
+  override fun getCurrentPosition(): Long = shifted(super.getCurrentPosition())
+
+  override fun getContentPosition(): Long = shifted(super.getContentPosition())
+
+  override fun getBufferedPosition(): Long = shifted(super.getBufferedPosition())
+
+  override fun getContentBufferedPosition(): Long = shifted(super.getContentBufferedPosition())
+
+  // How long the source lasts is on the same clock as where it is, and it has
+  // to be shifted with it: the segment starting at 2:00 of a four minute song
+  // is two minutes long, so leaving it alone put a position of 2:00 on a bar
+  // that ended there. Anything past the middle of a song came out pinned to
+  // the end. A segment with no length of its own says so and the track's own
+  // duration, which the app puts in the item, answers instead.
+  override fun getDuration(): Long = shifted(super.getDuration())
+
+  override fun getContentDuration(): Long = shifted(super.getContentDuration())
+
+  // Somebody scrubbing from the car or the lock screen is pointing at the
+  // clock this reports, so the offset comes back off before the player is
+  // asked. A source that cannot be seeked at all is handed over instead: the
+  // app knows how to get there, by asking the server for the stream starting
+  // at that second, and it is also the one place that knows what the seconds
+  // before the current segment even are.
+  override fun seekTo(positionMs: Long) {
+    val seek = onSeek
+    if (seek != null && !playerCanSeek()) {
+      seek(positionMs)
+      return
+    }
+    super.seekTo(positionMs - positionOffsetMs())
+  }
+
+  override fun seekTo(mediaItemIndex: Int, positionMs: Long) {
+    val seek = onSeek
+    if (seek != null && !playerCanSeek() && mediaItemIndex == currentMediaItemIndex) {
+      seek(positionMs)
+      return
+    }
+    super.seekTo(mediaItemIndex, positionMs - positionOffsetMs())
+  }
+}
+
+/** Wraps a player for a media session. See [MediaSessionPlayer]. */
+fun playerForMediaSession(
+  player: Player,
+  positionOffsetMs: () -> Long = { 0L },
+  onSeek: ((Long) -> Unit)? = null,
+): Player = MediaSessionPlayer(player, positionOffsetMs, onSeek)
+
+fun buildBasicMediaSession(
+  context: Context,
+  player: ExoPlayer,
+  positionOffsetMs: () -> Long = { 0L },
+  onSeek: ((Long) -> Unit)? = null,
+): MediaSession {
+  return MediaSession.Builder(context, playerForMediaSession(player, positionOffsetMs, onSeek))
     .setId("ExpoAudioBasicMediaSession_${player.hashCode()}")
     .build()
 }
