@@ -0,0 +1,103 @@
+import Foundation
+
+/// The lock screen's cover, fetched ahead of the track it belongs to: a
+/// download, and an encode behind it when the cover is animated, both better
+/// spent while the previous track still plays. `AudioPlayer.setNextSource`
+/// warms the track queued behind the current one — the same idea as Android's
+/// `PreloadingBitmapLoader` — and `MediaController.loadArtworkFromURL` asks
+/// here first, so a cover is fetched once for every caller that wants it, and
+/// the second ask of one has nothing left to wait for.
+final class ArtworkPreloader {
+  static let shared = ArtworkPreloader()
+
+  /// A cover, fetched: its bytes, and the clips cut from them for the lock
+  /// screen (nil when the cover does not animate, or the system is too old
+  /// to play an animated one).
+  struct Ready {
+    let data: Data
+    let square: AnyObject?
+    let tall: AnyObject?
+  }
+
+  private let lock = NSLock()
+  /// What was fetched, last write last, bounded by `limit`: a cover's bytes
+  /// run to a few megabytes when it animates, so only the handful that a skip
+  /// or a media reset asks for again is worth keeping.
+  private var stored: [URL: Ready] = [:]
+  private var order: [URL] = []
+  private var waiters: [URL: [(Ready?) -> Void]] = [:]
+  private var inflight: Set<URL> = []
+  private let delivery = DispatchQueue(label: "expo.modules.audio.artwork-preloader")
+  private let limit = 6
+
+  /// Nothing wants an answer: the point is only to have the cover later.
+  func warm(_ url: URL?) {
+    guard let url else { return }
+    fetch(url) { _ in }
+  }
+
+  /// The cover for `url`: here already, or on its way, or the fetch this call
+  /// starts. `completion` runs off the main thread, as the URL session's queue
+  /// did before it — the caller hops after it.
+  func fetch(_ url: URL, completion: @escaping (Ready?) -> Void) {
+    lock.lock()
+    if let ready = stored[url] {
+      lock.unlock()
+      delivery.async { completion(ready) }
+      return
+    }
+    waiters[url, default: []].append(completion)
+    if inflight.contains(url) {
+      lock.unlock()
+      return
+    }
+    inflight.insert(url)
+    lock.unlock()
+    start(url)
+  }
+
+  private func start(_ url: URL) {
+    URLSession.shared.dataTask(with: url) { [weak self] data, _, error in
+      guard let self else { return }
+      guard let data, error == nil else {
+        self.done(url, nil)
+        return
+      }
+      var square: AnyObject?
+      var tall: AnyObject?
+#if compiler(>=6.2)
+      if #available(iOS 26.0, tvOS 26.0, *) {
+        let clips = AnimatedArtwork.make(url: url, data: data)
+        square = clips.square
+        tall = clips.tall
+        // The encode starts now, while the track these clips belong to is
+        // still the next one: the file it writes is the lock screen's own
+        // cache, so a clip that lands before the move is there the moment
+        // the system asks for it.
+        (square as? AnimatedArtwork)?.whenReady {}
+        (tall as? AnimatedArtwork)?.whenReady {}
+      }
+#endif
+      self.done(url, Ready(data: data, square: square, tall: tall))
+    }.resume()
+  }
+
+  private func done(_ url: URL, _ ready: Ready?) {
+    lock.lock()
+    inflight.remove(url)
+    let pending = waiters.removeValue(forKey: url) ?? []
+    if let ready {
+      stored[url] = ready
+      order.removeAll { $0 == url }
+      order.append(url)
+      while order.count > limit, let oldest = order.first {
+        order.removeFirst()
+        stored.removeValue(forKey: oldest)
+      }
+    }
+    lock.unlock()
+    delivery.async {
+      pending.forEach { $0(ready) }
+    }
+  }
+}
