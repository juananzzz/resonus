+package expo.modules.audio
+
+import android.net.Uri
+import androidx.media3.common.C
+import androidx.media3.common.DataReader
+import androidx.media3.common.Format
+import androidx.media3.common.util.ParsableByteArray
+import androidx.media3.extractor.DefaultExtractorsFactory
+import androidx.media3.extractor.Extractor
+import androidx.media3.extractor.ExtractorInput
+import androidx.media3.extractor.ExtractorOutput
+import androidx.media3.extractor.ExtractorsFactory
+import androidx.media3.extractor.PositionHolder
+import androidx.media3.extractor.SeekMap
+import androidx.media3.extractor.SeekPoint
+import androidx.media3.extractor.SniffFailure
+import androidx.media3.extractor.TrackOutput
+import androidx.media3.extractor.mp4.FragmentedMp4Extractor
+import androidx.media3.extractor.text.SubtitleParser
+
+/**
+ * Extractors that can seek a file carrying no index of its own.
+ *
+ * A server transcoding on the fly writes into a pipe, so what comes out the
+ * other end is a bare run of frames: Navidrome's AAC is raw ADTS, and an MP3
+ * made that way carries a Xing header it never got to go back and fill in.
+ * Downloaded, that is exactly what ends up on disk, and ExoPlayer does not
+ * seek what it cannot index: it answers the seek by starting the track over
+ * from zero, which is what somebody dragging the slider sees (#123).
+ *
+ * Constant bitrate seeking is the answer to that case and to no other: it
+ * works out where a second lives from the length of the file and its
+ * bitrate, and it is only consulted when the container offers nothing
+ * better. A real MP4, a FLAC, or an MP3 with a header worth reading keeps
+ * its own seek table. And these files are transcodes at a bitrate that was
+ * asked for, which is the case the estimate is exact for.
+ *
+ * Deliberately not `setConstantBitrateSeekingAlwaysEnabled`: that one is for
+ * sources whose length is unknown, which is the stream, not the download. A
+ * transcode arriving over HTTP has no length and takes no range requests
+ * either, so guessing a byte offset in it would get us nothing to play. That
+ * one is re-requested from the server at the second we want instead.
+ *
+ * A fragmented M4A without an index is the other file media3 will not seek,
+ * and `FragmentSeekingExtractorsFactory` covers that one (#242).
+ *
+ * Kept out of AudioModule so `pnpm harness:extractor` runs this very factory.
+ */
+internal fun seekableExtractors(): ExtractorsFactory =
+  FragmentSeekingExtractorsFactory(DefaultExtractorsFactory().setConstantBitrateSeekingEnabled(true))
+
+/**
+ * Seeking in a fragmented MP4 that carries no index (#242).
+ *
+ * A fragmented M4A is a run of small `moof` + `mdat` pairs, and the only index
+ * media3 seeks one with is a `sidx` box up front. Plenty of files have none
+ * (anything saved straight from a DASH stream, which is what most rippers do),
+ * and media3 treats every seek into those as a seek to zero: drag the slider
+ * and the song starts over.
+ *
+ * Every fragment opens with the time it starts at (`tfdt`), though, so the
+ * file can be searched. When the fragmented extractor gives up, this reads the
+ * last fragment once to learn how long the song is, hands ExoPlayer a map from
+ * the first fragment to the last, and on each seek homes in on the fragment
+ * holding the second asked for, a few reads at most, before letting the real
+ * extractor carry on from there.
+ */
+internal class FragmentSeekingExtractorsFactory(
+  private val base: ExtractorsFactory
+) : ExtractorsFactory {
+  override fun createExtractors(): Array<Extractor> = wrap(base.createExtractors())
+
+  override fun createExtractors(uri: Uri, responseHeaders: Map<String, List<String>>): Array<Extractor> =
+    wrap(base.createExtractors(uri, responseHeaders))
+
+  override fun setSubtitleParserFactory(factory: SubtitleParser.Factory): ExtractorsFactory {
+    base.setSubtitleParserFactory(factory)
+    return this
+  }
+
+  @Deprecated("Deprecated in media3")
+  override fun experimentalSetTextTrackTranscodingEnabled(enabled: Boolean): ExtractorsFactory {
+    @Suppress("DEPRECATION")
+    base.experimentalSetTextTrackTranscodingEnabled(enabled)
+    return this
+  }
+
+  override fun experimentalSetCodecsToParseWithinGopSampleDependencies(codecs: Int): ExtractorsFactory {
+    base.experimentalSetCodecsToParseWithinGopSampleDependencies(codecs)
+    return this
+  }
+
+  private fun wrap(extractors: Array<Extractor>): Array<Extractor> =
+    Array(extractors.size) { i ->
+      val e = extractors[i]
+      if (e is FragmentedMp4Extractor) FragmentSeekingExtractor(e) else e
+    }
+}
+
+internal class FragmentSeekingExtractor(private val inner: Extractor) : Extractor {
+  private var input: ExtractorInput? = null
+  private lateinit var output: ExtractorOutput
+
+  /** Of the audio track, from its `mdhd`; 0 when it could not be read. */
+  private var timescale = 0L
+  private var declaredDurationUs = C.TIME_UNSET
+  private var firstFragment = C.INDEX_UNSET.toLong()
+
+  /** Set when the map was held back, until the extractor stops for the first time. */
+  private var tailPending = false
+
+  /** Where the extractor was when the last fragment was read, to go back to. */
+  private var resumeAt = C.INDEX_UNSET.toLong()
+  private var readingTail = false
+
+  /** Fragments whose start is known, by position. Our map is live when set. */
+  private var known: MutableList<Fragment>? = null
+
+  private var seekTargetUs = C.TIME_UNSET
+  private var seekHops = 0
+
+  /** No fragment starting before `timeUs` lies at or past `position`: where
+   *  the last scan began that only found one starting too late. */
+  private var ceiling: Fragment? = null
+
+  override fun sniff(input: ExtractorInput): Boolean = inner.sniff(input)
+
+  override fun getSniffFailureDetails(): List<SniffFailure> = inner.sniffFailureDetails
+
+  override fun init(output: ExtractorOutput) {
+    this.output = output
+    inner.init(Output(output))
+  }
+
+  override fun read(input: ExtractorInput, seekPosition: PositionHolder): Int {
+    this.input = input
+    if (timescale == 0L && input.position == 0L) timescale = readTimescale(input)
+    if (resumeAt != C.INDEX_UNSET.toLong()) return readTail(input, seekPosition)
+    if (seekTargetUs != C.TIME_UNSET) {
+      val result = homeIn(input, seekPosition)
+      if (result != null) return result
+    }
+    val result = inner.read(input, seekPosition)
+    // The map is sent from inside the read, which carries on to the end of the
+    // first sample: that is the byte to come back to, not the one the map was
+    // sent from, or the rest of the first fragment comes out as noise.
+    if (tailPending) {
+      tailPending = false
+      if (result == Extractor.RESULT_CONTINUE) resumeAt = input.position
+      else output.seekMap(SeekMap.Unseekable(declaredDurationUs))
+    }
+    return result
+  }
+
+  override fun seek(position: Long, timeUs: Long) {
+    inner.seek(position, timeUs)
+    // Zero is the start of the file, not the middle of a fragment: the
+    // extractor reads the header again and needs no help.
+    seekTargetUs = if (known != null && position > 0) timeUs else C.TIME_UNSET
+    seekHops = 0
+    ceiling = null
+  }
+
+  override fun release() = inner.release()
+
+  /**
+   * Out to the last fragment and back. Its start, and the one before it, say
+   * how long the song is; the extractor never sees the trip, since it picks up
+   * again at the very byte it left.
+   */
+  private fun readTail(input: ExtractorInput, seekPosition: PositionHolder): Int {
+    val length = input.length
+    if (!readingTail) {
+      readingTail = true
+      seekPosition.position = maxOf(resumeAt, length - TAIL_BYTES)
+      return Extractor.RESULT_SEEK
+    }
+    val bytes = peekUpTo(input, (length - input.position).coerceAtMost(TAIL_BYTES.toLong()).toInt())
+    val fragments = mutableListOf<Fragment>()
+    var k = 0
+    while (k <= bytes.size - BOX_HEAD) {
+      if (isFragmentAt(bytes, k)) {
+        val t = fragmentTimeUs(bytes, k)
+        if (t != C.TIME_UNSET) fragments.add(Fragment(input.position + k, t))
+      }
+      k++
+    }
+    val last = fragments.lastOrNull()
+    if (last == null || last.timeUs <= 0) {
+      output.seekMap(SeekMap.Unseekable(declaredDurationUs))
+    } else {
+      // The last fragment lasts about as long as the one before it did.
+      val span = if (fragments.size > 1) last.timeUs - fragments[fragments.size - 2].timeUs else 0L
+      val guessUs = last.timeUs + span
+      val declared = declaredDurationUs
+      val durationUs = if (declared != C.TIME_UNSET && declared >= last.timeUs && declared <= guessUs + span) declared else guessUs
+      known = (listOf(Fragment(firstFragment, 0)) + fragments).toMutableList()
+      output.seekMap(FragmentSeekMap(durationUs, firstFragment, last))
+    }
+    seekPosition.position = resumeAt
+    resumeAt = C.INDEX_UNSET.toLong()
+    return Extractor.RESULT_SEEK
+  }
+
+  /**
+   * One step towards the fragment that holds the second asked for: finds the
+   * next fragment from here and either settles on it or jumps again, in
+   * proportion between the closest fragments known on either side. Null once
+   * settled with the input at a fragment the extractor can read.
+   */
+  private fun homeIn(input: ExtractorInput, seekPosition: PositionHolder): Int? {
+    val known = known ?: return null
+    val target = seekTargetUs
+    val scanFrom = input.position
+    val nearby = nextFragments(input)
+    val found = nearby.firstOrNull()
+    for (f in nearby) if (known.none { it.position == f.position }) known.add(f)
+    known.sortBy { it.position }
+    val before = known.lastOrNull { it.timeUs <= target }
+    val after = known.firstOrNull { it.timeUs > target }
+    val settle = when {
+      // Past the last fragment: the last one that starts in time.
+      found == null -> before
+      // The read may have gone past the second asked for: the last fragment of
+      // it that starts in time, if it is close enough.
+      before != null && before.position >= found.position && target - before.timeUs <= CLOSE_ENOUGH_US -> before
+      // Nothing lies between `before` and one that starts too late, so the
+      // second asked for is inside `before`: straight from it to the next, or
+      // both side by side in this read.
+      before != null && after != null &&
+        ((found == after && scanFrom <= before.position + 1) ||
+          (before in nearby && nearby.getOrNull(nearby.indexOf(before) + 1) == after)) -> before
+      seekHops >= MAX_HOPS -> before ?: found
+      else -> null
+    }
+    if (settle != null || found == null) {
+      seekTargetUs = C.TIME_UNSET
+      if (settle == null) return Extractor.RESULT_END_OF_INPUT
+      if (settle.position == input.position) return null
+      seekPosition.position = settle.position
+      return Extractor.RESULT_SEEK
+    }
+    seekHops++
+    if (found.timeUs > target && scanFrom < (ceiling?.position ?: Long.MAX_VALUE)) {
+      ceiling = Fragment(scanFrom, found.timeUs)
+    }
+    val lo = before ?: known.first()
+    val hi = listOfNotNull(after, ceiling).minByOrNull { it.position } ?: known.last()
+    val aimUs = (target - LEAD_US).coerceAtLeast(lo.timeUs)
+    // Bytes are only roughly in proportion to time (a quiet intro takes next to
+    // nothing), so every other jump halves the gap instead: that bounds the
+    // search however wrong the proportion is.
+    val share = when {
+      // A gap one read covers is read whole, from its start.
+      hi.position - lo.position <= SCAN_BYTES -> 0.0
+      seekHops % 2 == 0 -> 0.5
+      hi.timeUs > lo.timeUs -> (aimUs - lo.timeUs).toDouble() / (hi.timeUs - lo.timeUs)
+      else -> 0.0
+    }
+    val next = lo.position + ((hi.position - lo.position) * share).toLong()
+    // Always past `lo`, so the scan finds the fragment after it at worst.
+    seekPosition.position = next.coerceIn(lo.position + 1, maxOf(lo.position + 1, hi.position - 1))
+    return Extractor.RESULT_SEEK
+  }
+
+  /**
+   * The fragments from the input's position on, as many as sit in one read,
+   * the nearest first; empty when there are none. Skips what comes before the
+   * first, so the input may be left further on than it was.
+   */
+  private fun nextFragments(input: ExtractorInput): List<Fragment> {
+    var scanned = 0L
+    while (scanned < MAX_SCAN_BYTES) {
+      input.resetPeekPosition()
+      val bytes = peekUpTo(input, SCAN_BYTES)
+      input.resetPeekPosition()
+      if (bytes.size < BOX_HEAD) return emptyList()
+      val found = mutableListOf<Fragment>()
+      for (k in 0..bytes.size - BOX_HEAD) {
+        if (!isFragmentAt(bytes, k)) continue
+        val t = if (k + int(bytes, k) <= bytes.size) {
+          fragmentTimeUs(bytes, k)
+        } else if (found.isEmpty()) {
+          // The nearest one's `tfdt` may sit past this read: look at all of it.
+          input.advancePeekPosition(k)
+          val moof = peekUpTo(input, int(bytes, k).coerceAtMost(MAX_MOOF_BYTES))
+          input.resetPeekPosition()
+          fragmentTimeUs(moof, 0)
+        } else {
+          C.TIME_UNSET
+        }
+        if (t != C.TIME_UNSET) found.add(Fragment(input.position + k, t))
+        else if (found.isEmpty()) return emptyList()
+      }
+      if (found.isNotEmpty()) return found
+      val step = bytes.size - BOX_HEAD + 1
+      input.skipFully(step)
+      scanned += step
+    }
+    return emptyList()
+  }
+
+  /** Reads what is there, up to `max` bytes, from the peek position on. */
+  private fun peekUpTo(input: ExtractorInput, max: Int): ByteArray {
+    val buf = ByteArray(max)
+    var n = 0
+    while (n < max) {
+      val read = input.peek(buf, n, max - n)
+      if (read == C.RESULT_END_OF_INPUT) break
+      n += read
+    }
+    return if (n == max) buf else buf.copyOf(n)
+  }
+
+  /** The track's timescale from the `mdhd` in the header, or 0. */
+  private fun readTimescale(input: ExtractorInput): Long {
+    input.resetPeekPosition()
+    val bytes = peekUpTo(input, HEADER_BYTES)
+    input.resetPeekPosition()
+    val i = find(bytes, MDHD, 0)
+    if (i < 0 || i + 8 > bytes.size) return 0
+    val v1 = bytes[i + 4].toInt() == 1
+    val at = i + 8 + if (v1) 16 else 8
+    return if (at + 4 <= bytes.size) int(bytes, at).toLong() and 0xffffffffL else 0
+  }
+
+  /** When the fragment at `k` starts, from its `tfdt`. */
+  private fun fragmentTimeUs(b: ByteArray, k: Int): Long {
+    if (timescale <= 0) return C.TIME_UNSET
+    val end = (k + int(b, k)).coerceAtMost(b.size)
+    val i = find(b, TFDT, k, end)
+    if (i < 0 || i + 8 > end) return C.TIME_UNSET
+    val v1 = b[i + 4].toInt() == 1
+    val at = i + 8
+    val units = if (v1) {
+      if (at + 8 > end) return C.TIME_UNSET
+      (int(b, at).toLong() shl 32) or (int(b, at + 4).toLong() and 0xffffffffL)
+    } else {
+      if (at + 4 > end) return C.TIME_UNSET
+      int(b, at).toLong() and 0xffffffffL
+    }
+    return units * 1_000_000L / timescale
+  }
+
+  private inner class Output(private val out: ExtractorOutput) : ExtractorOutput {
+    override fun track(id: Int, type: Int): TrackOutput = out.track(id, type)
+
+    override fun endTracks() = out.endTracks()
+
+    override fun seekMap(seekMap: SeekMap) {
+      val input = input
+      // A `sidx` beats anything worked out here, and without a length (a
+      // stream generated on the fly) there is no last fragment to go and read.
+      if (seekMap.isSeekable || input == null || input.length == C.LENGTH_UNSET.toLong() || timescale <= 0) {
+        out.seekMap(seekMap)
+        return
+      }
+      // Sent the moment the first `moof` header has been read.
+      declaredDurationUs = seekMap.durationUs
+      firstFragment = input.position - 8
+      tailPending = true
+    }
+  }
+
+  private data class Fragment(val position: Long, val timeUs: Long)
+
+  /** Between the first fragment and the last, in proportion. Only a first
+   *  guess: `homeIn` takes it from there. */
+  private class FragmentSeekMap(
+    private val durationUs: Long,
+    private val first: Long,
+    private val last: Fragment
+  ) : SeekMap {
+    override fun isSeekable() = true
+
+    override fun getDurationUs() = durationUs
+
