// What a string means, for whoever is translating it.
//
// The English text is the key, so two different things that English says with
// the same word arrive here as one key: `Direction` is a sort order and not a
// compass, `Rate` is a verb and not a bitrate. This file is where that gets
// said, one line per key, and it is the only copy. The tools read it:
//
//   pnpm i18n:scaffold <locale>   puts each note above the string to translate
//   pnpm i18n:status <locale>     shows it next to what is missing
//
// so a note written here reaches the person translating without them having to
// know it exists. A note is only worth adding for a string that is ambiguous or
// surprising on its own; where a string shows up is worked out from the code
// (see `scripts/i18n-lib.mjs`) and does not need writing down.
//
// `keepEnglish` is the other half: strings that are meant to stay in English on
// purpose. They are not counted as missing.
{
  "notes": {
    // ── The app's own words ──────────────────────────────────────────────────
    // These come back on screen after screen. Whatever each language settles
    // on, it reads much better said the same way every time.
    "Queue": "The list of songs waiting to play. Not a playlist",
    "Playlist": "A list saved on the server. Not the queue",
    "Shuffle": "Play in random order",
    "Repeat": "Start again at the end",
    "Crossfade": "One song fading into the next",
    "Downloads": "Songs saved on the phone, to play with no connection",
    "Offline mode": "The app working with no server: downloads only",
    "Shuffle favorites": "Shortcut on the app's launcher icon (long press). Short: launchers cut long labels",
    "Continue listening": "Shortcut on the app's launcher icon (long press): resumes the last queue. Short: launchers cut long labels",
    "Left on {player}": "Same card, when that app is no longer playing but its queue is the last one saved: where the person left off. {player} is the app's name",
    "Playing on {player}": "Heading of the card at the top of Home: a song playing right now in another app or on another device of the same account. {player} is that app's name, like Feishin",
    "Song cache": "Copies of streamed songs the app keeps by itself and deletes to make room. Not the same as Downloads, which the person chose",

    // ── Sorting & filtering ──────────────────────────────────────────────────
    "Direction": "Sort sheet: the ascending vs descending toggle. Not a compass direction",
    "A-Z": "Sort option: the order of a list",
    "Alphabetical": "Sort option: the order of a list",
    "Ascending": "Sort option: the order of a list",
    "Descending": "Sort option: the order of a list",
    "Filter artists": "Search box that narrows the list as you type, rather than a filter you set",
    "Filter genres": "Search box that narrows the list as you type, rather than a filter you set",

    // ── Library & scanning (Settings › Library) ──────────────────────────────
    "Source": "The music source (which server, or local). Not source code",
    "Change source": "The music source (which server, or local). Not source code",
    "Device": "In offline mode, where the phone's own music is read from: the whole device, as opposed to `Folder`, one folder you picked. Not a server library",
    "Folder": "In offline mode, where the phone's own music is read from: one folder you picked, as opposed to `Device`, the whole phone",
    "Scan": "Trigger the server's library scan",
    "Rescan": "Trigger the server's library scan again",
    "Scan status": "How the server's library scan is going",
    "Local music": "Music stored on the phone itself",

    // ── Settings section headers (short titles grouping toggles) ─────────────
    "Elements": "Which player elements to show",
    "Buttons": "Which player buttons to show",
    "Interaction": "Section header grouping toggles",
    "Interface": "Section header grouping toggles",
    "Size": "The size of the quick grid tiles",
    "Sources": "Which shortcuts the quick grid shows",

    // ── Servers & network (Login, Settings › Network) ────────────────────────
    "Advanced": "The link that expands the advanced connection options",
    "Local profile": "The on-device profile, with no server account. Its library screen is `Local music`",
    "This phone": "The on-device profile, with no server account",
    "Media server": "The type subtitle under Jellyfin",
    "Subsonic-compatible": "The subtitle under OpenSubsonic / Ampache",
    "Local": "An address on the same network (LAN). Nothing to do with the local profile",
    "Remote": "An address reachable from outside the home network",
    "Offline · your downloads": "Settings subtitle shown in offline mode",

    // ── Streaming & download quality ─────────────────────────────────────────
    "Original": "Quality option: the file exactly as it is on the server, nothing transcoded. It also appears in quotes inside two descriptions on those screens, so use the same wording in all three",
    "Server default": "Codec option meaning \"let the server decide\" what to transcode to",
    "Not used": "Replaces the codec's value when that network's quality is `Original`. Nothing is transcoded then, so the codec setting has nothing to do and the row is greyed out",

    // ── Playback, audio & equalizer ──────────────────────────────────────────
    "By track": "Volume normalization (ReplayGain) mode: even out loudness track by track",
    "By album": "Volume normalization (ReplayGain) mode: even out loudness album by album",
    "Bands": "The equalizer's frequency sliders",
    "Reset bands": "Put the equalizer's frequency sliders back to flat",
    "Preset": "An equalizer preset. Not a bitrate",
    "Custom": "Settings › Equalizer, the first option of the preset list: none of the presets below it, the bands left wherever you dragged them. Also `Custom::color`, the heading over your own accent colour in Settings › Theme (add it to your file if the word needs another form for a colour)",
    "Off": "A setting value meaning disabled (crossfade, normalization…)",

    // ── Player, output & queue ───────────────────────────────────────────────
    "Devices": "The audio output devices to cast to",
    "Currently playing on": "Heading above the output the music is coming out of right now, at the top of the output sheet",
    "Colored mini player": "Tint the mini player with the colour of the cover art",
    "Cover color": "The colour taken from the cover art",
    "Player background": "What is drawn behind the player: the blurred artwork, or a flat tint",
    "Skip buttons": "The seek forward / back buttons setting",
    "Next": "Player control: the next track (accessibility label)",
    "Previous": "Player control: the previous track (accessibility label)",
    "Next in queue": "Queue screen header: the track that plays next",
    "At the end of the queue": "Queue screen header: the songs 'Add to queue' put after everything else",
    "Show cover": "Lyrics screen: the button that goes back to the cover art",
    "About the artist": "The label over the photo on the artist card, the one below the player controls",

    // ── Artist, playlists & radio ────────────────────────────────────────────
    "About": "The heading over an artist's biography, and the name of the settings page about the app. Two very different uses of one English word, so `About::artist` and `About::app` exist for a language that needs two words",
    "Popular": "The artist's popular / top tracks",
    "Appears on": "Albums the artist appears on: features, compilations",
    "Similar artists": "Related artists",
    "Public playlist": "Toggle that makes a playlist public on the server",
    "Change cover": "Replace the cover image of a playlist or station",
    "Name": "The Name field when editing a playlist or a station",
    "Website (optional)": "Field when adding a radio station",
    "Stream URL": "Field when adding a radio station",
    "View image": "Artist screen: opens the artist photo full screen, since the header crops it",
    "View cover": "The same as `View image`, for album and playlist artwork",

    // ── Home & personalization ───────────────────────────────────────────────
    "Discover": "Home section: discovery suggestions",
    "Recents": "Library section and its sort order: recently opened items",
    "Greeting": "Home's \"Good morning\" line",
    "Custom greeting": "A greeting of your own, replacing Home's \"Good morning\" line",
    "Quick grid": "The grid of shortcut tiles on Home",
    "Home chips": "The row of tappable category chips",
    "Show chips": "A switch over the Home chips list: turns every chip on or off at once",
    "Song lists": "The setting for how song lists look",
    "Show explicit tag": "A switch: whether to draw the E on anything carrying a parental advisory. \"Explicit\" here is the music-industry label for strong language, not \"clear\" or \"stated outright\"",
    "Home sections": "Reorder which sections appear on Home",
    "On cover double tap": "Settings > Player: what tapping the album artwork twice does",
    "Play or pause": "One of its options: the same as the play button",
    "Music folders": "Settings > Local music: the list of phone folders the local profile reads its music from",
    "Add another folder": "Adds one more phone folder to the local profile's list",
    "Keep at least one folder": "Refusing to remove the last folder of a local profile, which would leave it with no music",
    "That folder is already there": "The folder just picked is already in the local profile's list",
    "New releases": "Home shelf and album sort: albums by the year they came out, newest first. Not \"Recently added\", which is when the server got hold of them",
    "System": "Two places: a theme setting (use whichever appearance the phone itself is set to, light or dark), and `System::section`, the heading in Settings › Quality & playback over Keep screen on and the battery warning. Add `System::section` to your file if one word cannot do both",
    "Pin favorites": "Pin favourites to the quick grid",

    // ── Actions & verbs (easy to translate as the wrong part of speech) ──────
    "Rate": "Verb: give it stars. Used for a song and for an artist. Not \"bitrate\"",
    "Restore": "Restore settings to their defaults",
    "Reorder": "Enter drag-to-reorder mode",
    "Turn off": "Turn off the sleep timer",
    "Start mix": "Start an auto-generated radio mix from this song",
    "More options": "Read out by the screen reader for the three-dot button, which is ⋮ on a song row and in the player and ⋯ in a screen's header",
    "More": "A \"see more\" action, and the third button of the selection bar, the one that opens the rest of what it can do",

    // ── Empty states: what a screen says when it has nothing to show ─────────
    "No albums yet": "Empty state heading",
    "No artists yet": "Empty state heading",
    "No genres yet": "Empty state heading",
    "No favorites yet": "Empty state heading",
    "No favorite albums": "Empty state heading on the favourites tab",
    "No favorite artists": "Empty state heading on the favourites tab",
    "No playlists yet": "Empty state heading",
    "No radio stations": "Empty state heading",
    "No albums in this genre": "Empty state heading",
    "No songs in this genre": "Empty state heading",
    "Nothing to shuffle yet": "Empty state: there is nothing here to play in random order",
    "This folder is empty.": "Empty state, browsing the server by folder",
    "This playlist is empty": "Empty state heading",
    "The queue is empty.": "Empty state on the queue screen",
    "Your library looks empty.": "Empty state: the server answered, and had nothing",
    "Star albums to see them here.": "The line under an empty state, saying how to fill it",
    "Star artists to see them here.": "The line under an empty state, saying how to fill it",
    "Tap the heart on songs to see them here.": "The line under an empty state, saying how to fill it",
    "Songs you play will show up here.": "The line under an empty state, saying how to fill it",
    "Create your first playlist to get started.": "The line under an empty state",
    "Add songs from the ⋯ menu of any song.": "The line under an empty playlist, saying how to fill it",
    "Play a song or album to start the queue.": "The line under the empty queue",
    "Tap + to add an internet radio station.": "The line under an empty state, pointing at the + button",
    "Add internet radio stations on your server and they'll show up here.": "The line under an empty state: the stations live on the server, not in the app",
    "Genres come from your music's tags.": "The line under an empty state: the app does not invent them",
    "Nothing to suggest yet — play some music first.": "The line under an empty state on the add-favourites screen",
    "No lyrics available for this song.": "Empty state on the lyrics screen",
    "Nothing played yet": "Empty state on the listening history",
    "Your most played albums will show up here.": "The line under an empty state, before anything has been played",
    "Your recently played albums will show up here.": "The line under an empty state, before anything has been played",

    // ── Errors a screen shows with a Retry button ────────────────────────────
    "Couldn't load the album.": "Error on the screen, with a Retry button",
    "Couldn't load the artist.": "Error on the screen, with a Retry button",
    "Couldn't load the playlist.": "Error on the screen, with a Retry button",
    "Couldn't load the folder.": "Error on the screen, with a Retry button",
    "Couldn't load albums.": "Error on the screen, with a Retry button",
    "Couldn't load artists.": "Error on the screen, with a Retry button",
    "Couldn't load songs.": "Error on the screen, with a Retry button",
    "Couldn't load genres.": "Error on the screen, with a Retry button",
    "Couldn't load favorites.": "Error on the screen, with a Retry button",
    "Couldn't load folders.": "Error on the screen, with a Retry button",
    "Couldn't load playlists.": "Error on the screen, with a Retry button",
    "Couldn't load radio stations.": "Error on the screen, with a Retry button",
    "Couldn't reach the server. Check your connection.": "Error on Home when the server does not answer at all",
    "Playlists are not available in offline mode.": "Shown instead of a playlist when there is no connection",

    // ── Search boxes and the questions above them ────────────────────────────
    "What do you want to listen to?": "The placeholder in the search box, worded as a question",
    "What would you like to add?": "Heading of the screen for adding favourites",
    "Find an album": "The search box's placeholder on that screen",
    "Find in favorites": "Placeholder of the search box that narrows the favourites already shown",
    "Where should we get your music?": "Heading when choosing where the phone's own music is read from",

    // ── Signing in ───────────────────────────────────────────────────────────
    "Sign in": "The button that signs in. A verb",
    "Username": "The username field",
    "Password": "The password field, on the login screen and wherever the server asks again",
    "Add profile": "Add another account, keeping the ones already saved",
    "Choose the server type": "The line above the list of server kinds",
    "Couldn't sign in": "Error when we do not know why it failed",
    "Couldn't sign in; check the account": "Error when the server answered and refused the credentials",
    "{name} is not available yet 🚧": "A server type shown but not supported yet. `{name}` is its name, and the sign is part of the message",
    "Remove profile?": "Dialog title: take a saved account off this phone",
    "Its downloads and its offline copy of the library will be deleted from this device.": "The line under that title",
    "The music on your device is not touched.": "The rest of that warning: only the account's own downloads go",
    "We need permission to read your device music.": "Android has not granted access to the phone's files yet",
    "All the music on your device.": "The line under `Scan the whole phone`",
    "Only the music in the folder you choose.": "The line under `Choose a folder (recommended)`",
    "Listen to music stored on your device, without a server. Choose where from:": "The line under `Music on your device`, before the two ways of finding it",

    // ── Playlists and stations, editing them ─────────────────────────────────
    "Edit playlist": "Menu action, and the title of the sheet it opens",
    "Delete playlist": "Menu action, in red",
    "Delete “{name}”?": "Dialog title. `{name}` is the playlist or station",
    "Playlist deleted": "Toast, with an undo button",
    "Playlist updated": "Toast after saving a change",
    "Save": "The confirm button of an edit sheet. A verb",
    "Done": "The button that leaves drag-to-reorder, or accepts a fine-tuned number",
    "Remove cover": "Screen reader label for the small x on a chosen picture",
    "Visible to other users on the server": "The line under `Public playlist`",
    "Your password is needed to upload images and will be stored securely.": "The line explaining why the password is asked for again",
    "Your server doesn't support playlist covers": "The server is too old, or is not Navidrome",
    "Your server doesn't support radio covers": "The server is too old, or is not Navidrome",
    "Artwork upload is disabled on the server": "The server can do it but has it turned off",
    "Couldn't update the cover": "Toast: the upload failed",
    "Add station": "Title of the sheet for adding an internet radio station",
    "Edit station": "Title of the same sheet when changing one",
    "Delete station": "Menu action, in red",
    "Remove “{name}” from your server?": "Dialog title: stations live on the server, so this deletes it for everybody",
    "The stream URL must start with http:// or https://": "Validation message under the address field",
    "{msg} It will keep downloading songs added to this playlist later.": "`{msg}` is the ordinary download message, and this adds what auto-download means on top of it",

    // ── The queue ────────────────────────────────────────────────────────────
    "Pick up the queue from other players": "A switch: whether to take the queue another player left on the server when the app is opened with nothing playing",
    "Get the server's queue": "Queue screen action: replace what is playing here with the queue the server has, which is the one left on another player",
    "Queue brought over": "The toast that says it worked",
    "The server has no saved queue": "The toast when the server had nothing to bring over",
    "Clear queue": "Menu action: empty the list of what is coming",
    "Queue cleared": "Toast",
    "Removed from queue": "Toast",
    "The current song keeps playing.": "The line under the clear-queue dialog: only what is coming goes",
    "The mix won't grow any further": "Toast after stopping the mix: what is in the queue stays, nothing new is added",

    // ── History, settings and the rest ───────────────────────────────────────
    "History": "The listening history: what was played and when",
    "Clear history": "Throw the listening history away",
    "History cleared": "Toast",
    "Settings": "The app's settings, and the button that opens them",
    "Change profile": "Go back to the list of saved profiles. The password is kept, so nothing has to be typed again",
    "Settings restored": "Toast after putting the settings back to their defaults",
    "Your preferences will go back to their defaults. Your language stays.": "The line under that dialog",
    "Report a bug": "Opens a new issue on GitHub",
    "Share diagnostic report": "Settings › About, under “Report a bug”: hands over a plain-text report (setup and recent playback errors) through the share sheet",
    "FAQ": "Opens the page of frequently asked questions on GitHub. Spell it out if that reads better in your language than the initials",
    "Cache cleared": "Toast: what was remembered from the server was thrown away. Downloads are untouched",
    "Couldn't rescan": "Toast: going through the phone's own files failed",
    "Couldn't start the scan": "Toast: the server refused to start a scan",
    "Scan started": "Toast: the server is now looking for new music",
    "Keep at least one library on": "Toast: at least one of the server's libraries has to stay ticked",
    "Add server address": "Title of the dialog for adding another address for this account",
    "Edit server address": "Title of the same dialog when changing one",
    "Address added": "Toast",
    "Address updated": "Toast",
    "This address is already in the list.": "Validation message: that one is already there",
    "Couldn't reach this address with your account.": "Validation message: nothing answered there, or the account was refused",
    "Back": "Screen reader label for the back arrow. A direction, not a verb",
    "Hold to go back to {tab}": "The hint on holding the back arrow. `{tab}` is Home, Search or Library",
    "Lyrics": "The words of the song. Also a line of the storage bar, where it is their size on the phone",
    "{n} removed from favorites": "Toast. `{n}` is a count of songs",
    "Cancel": "The button that closes a dialog without doing anything, and the one beside a search box",

    // ── Adding songs to a playlist ───────────────────────────────────────────
    "Add to a playlist": "Menu action: put this song, album or selection into a playlist",
    "New playlist": "Row at the top of the playlist picker, and the button on an empty library: make one",
    "Added to “{name}”": "Toast. `{name}` is the playlist's name",
    "{n} added to “{name}”": "Toast when several songs went in at once. `{n}` is a count of songs",
    "Already added": "Title of the dialog that warns the song is in that playlist already",
    "This song is already in “{name}”.": "The line under that title. `{name}` is the playlist",
    "{n} of {songs} are already in “{name}”.": "The same warning when adding several at once and only some of them are already there. `{n}` is how many of them are, and `{songs}` already reads as a count (\"12 songs\"), so the sentence is like \"3 of 12 songs are already in “Rock”.\"",
    "All {songs} are already in “{name}”.": "The same warning when every one of the several being added is already there. `{songs}` already reads as a count (\"12 songs\")",
    "Add anyway": "The confirm button of that warning: put it in a second time",
    "Add only the new ones": "The other button of that warning, when some are already in the playlist and some are not: leave the ones that are and add the rest",
    "Couldn't add to the playlist": "Toast: the server refused",
    "Couldn't create the playlist": "Toast: the server refused",

    // ── Downloading, and the dialogs around it ───────────────────────────────
    "Download": "The confirm button of the download dialog, and what the screen reader calls the download button. A verb",
    "Download “{name}”?": "Dialog title. `{name}` is an album, artist or playlist",
    "{songs} will be saved to this device.": "The line under that title. `{songs}` is already worded and inflected, \"12 songs\"",
    "{songs} will be saved to this device (about {size}).": "The same line when the size is known. `{size}` is like \"340 MB\"",
    "{songs} need about {size}, but only {free} is free. The download may stop partway.": "The same line when the phone is nearly full",
    "Downloading…": "Toast: the download has started. The songs arrive one by one after this",
    "Song downloaded": "Toast: one song finished",
    "{n} songs downloaded": "Toast: a whole album or playlist finished",
    "{n} songs couldn't be downloaded": "Toast: some failed, the rest are there",
    "Download stopped": "Toast: the download was stopped part way",
    "Stop download?": "Dialog title: stop a download that is running",
    "Songs already downloaded will be kept.": "The line under that title: stopping does not undo what already arrived",
    "Remove download?": "Dialog title: delete the files of something already downloaded",
    "“{name}” will no longer be available offline.": "The line under that title. `{name}` is the album, artist or playlist",
    "Download removed": "Toast: the file was deleted, the song stays in the library",
    "Delete downloads": "Menu action: delete the downloaded files of everything here",
    "{n} songs deleted": "Toast after deleting downloads. `{n}` is how many files went",
    "Connect to Wi-Fi to download": "Toast: downloading over mobile data is turned off in the settings",
    "This download is a {n} kbps copy, not the original file.": "Shown before exporting: the file on the phone was transcoded when it was downloaded. `{n}` is a bitrate",

    // ── Getting a file out of the app ────────────────────────────────────────
    "Export “{name}”?": "Dialog title. `{name}` is an album or a playlist",
    "{n} songs, {size}, copied into a folder of their own.": "The line under that title",
    "Export {songs}?": "The same title for a selection instead of a whole album. `{songs}` already reads as a count (\"12 songs\"), so it comes out like \"Export 12 songs?\"",
    "{size} copied into the folder you pick.": "The line under that one. Those go loose into the chosen folder, since a handful of songs has no name to give a folder of their own",
    "{n} songs exported": "Toast when it finished",
    "{n} of {m} songs exported": "Toast when only some of them made it",
    "Couldn't save the file": "Toast: writing to the chosen folder failed",
    "Couldn't send the file": "Toast: handing it to another app failed",
    "Sending to another app isn't available on this device": "Toast: this phone has nothing that takes a shared file",

    // ── Favourites ───────────────────────────────────────────────────────────
    "Add to favorites": "Menu action and screen reader label for the heart. A verb",
    "Remove from favorites": "The same button when it is already a favourite, and the menu entry that takes a whole selection out",
    "Added to favorites": "Toast",
    "Removed from favorites": "Toast",
    "Remove from playlist": "Menu action: take this song out of the playlist it was opened from",
    "Removed from playlist": "Toast, with an undo button next to it",

    // ── The battery warning ──────────────────────────────────────────────────
    "Battery optimization is on": "Title of the card warning that Android may cut playback off",
    "Open settings": "Its confirm button: goes to Android's own settings, not the app's",
    "Don't remind me": "Its other button: never show this again",

    // ── The sleep timer, once it is running ──────────────────────────────────
    "Sleep timer ({n} min left)": "The menu row while it is counting down. `{n}` is minutes still to go",
    "Sleep timer (end of song)": "The same row when it is set to stop at the end of this song",
    "Will pause in {n} min": "Toast when it is set",
    "Will pause when the song ends": "Toast when it is set to the end of the song",

    // ── Pinning, mixing, casting ─────────────────────────────────────────────
    "You can pin up to {n} items.": "Toast: there is no room for another pinned thing. `{n}` is the limit",
    "Couldn't find anything to mix with this song": "Toast: the server had nothing similar to carry on with",
    "This song can't be cast": "Toast: the speaker or TV will not take this file",
    "Couldn't play the song": "Toast: the app could not start it at all",

    // ── Empty states and errors that offer another go ────────────────────────
    "Retry": "The button on an error message: try again. A verb",
    "No results for “{q}”": "Empty state. `{q}` is what was typed",
    "Find in playlist": "Placeholder of the search box hidden above a tracklist, for finding a song within it",
    "More from {artist}": "Heading under an album: their other records. `{artist}` is the name",
    "Disc {n}": "Heading over the songs of one disc of a multi-disc album. `{n}` is its number",

    // ── Words that are a verb in one place and a noun in another ─────────────
    "Clear": "Read out by the screen reader for the small x that empties a search box. A verb",
    "Close": "Read out by the screen reader for a button that closes what is open. A verb",
    "Create": "The confirm button of the new-playlist dialog. A verb",
    "Play": "Read out by the screen reader for the play button. A verb",
    "Pause": "Read out by the screen reader for the pause button. A verb",
    "Stop": "Stop a download that is running. Not stop playback",
    "Remove": "Take something out of a list. Deleting for good is `Delete`",
    "Remove download": "Delete the downloaded file, keeping the song in the library",
    "Sort": "Read out by the screen reader for the button that opens the sort options. A verb",
    "Sort by": "Heading over the sort options",
    "Share": "Make a link on the server that others can open. Getting the file itself out is `Export`",
    "Export “{name}”?": "Confirms getting the files of an album or playlist out of the app",
    "Exit": "Leave the local profile and go back to choosing a server",
    "Exit local mode": "Leave the profile that plays the phone's own files",

    // ── Search results and headings ──────────────────────────────────────────
    "Album": "In search results, the little word under a result saying what kind of thing it is",
    "Artist": "In search results, the little word under a result saying what kind of thing it is",
    "Song": "In search results, the little word under a result saying what kind of thing it is",
    "Albums": "A heading over a list of them, never a count",
    "Artists": "A heading over a list of them, never a count",
    "Genres": "A heading over a list of them, never a count",
    "Folders": "A heading: browsing the server by folder instead of by album",
    "Show all": "Opens the full list of what the row is showing a few of",
    "All releases": "In an artist's ⋯ menu: it opens everything they have released as one list, of no particular kind. \"Releases\" as the records themselves, the way a discography counts them",

    // ── The shelves of a discography ─────────────────────────────────────────
    // Every one of these is a heading over the records of one kind on an
    // artist's page, and the kinds are MusicBrainz's own release types, read off
    // the files' `RELEASETYPE` tag. So each is a category of record and never a
    // count, an adjective or a verb, and the word your language already uses for
    // that kind of record is the right one. The full definitions, which are
    // worth a look for the odd ones, are at
    // https://musicbrainz.org/doc/Release_Group/Type
    "EPs": "Shelf heading: records longer than a single and shorter than an album",
    "Singles": "Shelf heading: records built around one song",
    "Live": "Shelf heading: records of a performance in front of an audience. Not the verb, and not “currently playing”",
    "Compilations": "Shelf heading: records collecting older recordings, a “best of” or a various-artists collection",
    "Soundtracks": "Shelf heading: the music of a film, a series, a play or a game",
    "Remixes": "Shelf heading: records that are mostly remixed material. `Remixes` is widely used as-is in several languages; keep it if that is true of yours",
    "DJ-mixes": "Shelf heading: recordings of several tracks blended one into the next by a DJ. Kept as-is in Spanish and Catalan, since the term travels",
    "Mixtapes": "Shelf heading: MusicBrainz's “Mixtape/Street”, promotional records with new material, common in rap and hip hop. Kept as-is where the term travels",
    "Demos": "Shelf heading: rough recordings made to be passed around rather than released. Kept as-is in Spanish and Catalan, though a language with its own word for these should use it",
    "Broadcasts": "Shelf heading: records of something first put out on radio, television or as a podcast",
    "Spoken word": "Shelf heading: records of speech rather than music. Not a count, so no plural is needed if yours would be awkward",
    "Interviews": "Shelf heading: records of somebody being interviewed, usually the artist",
    "Audiobooks": "Shelf heading: a book read aloud by one narrator, no music",
    "Audio dramas": "Shelf heading: a play performed for the ear, with several voices rather than one narrator. Radio drama is the same thing where that name is the familiar one",
    "Field recordings": "Shelf heading: records made of the world itself, nature or a city, rather than of performed music",
    // `Other` is the last shelf too, and it is described further down, where it
    // was already explained for the storage bar. One string, one note.
    "Show more": "Unfolds the rest of a text that was cut short",
    "Show less": "Folds it back",
    "No results": "Nothing matched what was typed",
    "Nothing played yet": "Empty state: this phone has not played anything yet",
    "Recent searches": "What was searched for before, kept on the phone",

    // ── Picking several at once ──────────────────────────────────────────────
    "Select all": "Tick every song in the list at once",
    "{n} selected": "How many songs are ticked right now",
    "Nothing to change": "Answer to favouriting a selection that already is one, or unfavouriting one that isn't",

    // ── Lists and how they look ──────────────────────────────────────────────
    "Grid view": "Show the list as cards in a grid",
    "View": "Title of the menu that chooses how a collection is drawn, and the label of the button that opens it. A noun: what you are looking at, not the verb",
    "Columns": "The same menu's title on a screen that has no list to switch to, so all it chooses is the density",
    "List": "An option in that menu: one row per item, instead of cards",
    "{n} columns": "The other options in that menu: cards, this many across. `{n}` is 2, 3 or 4, so it is always plural",
    "List view": "Show it as rows, one under the other",
    "Show artwork": "Whether song rows carry the album's little picture",
    "Show artist photo": "Whether the artist's photo shows at the top of their screen",
    "Show disc titles": "On an album in several discs, whether each disc's own name shows",
    "Show genres": "Whether a song row says its genre",
    "Show song duration": "Whether a song row says how long the song is",
    "Show quick grid": "Whether the grid of shortcut tiles shows on Home",
    "Recent albums": "A source the quick grid can draw its tiles from",
    "{n} cards": "How many tiles fit across the quick grid. `{n}` is a number of columns",
    "Show greeting": "Whether Home says \"Good morning\" at the top",
    "Show previous tracks": "Whether the queue keeps the songs already played, dimmed, above the current one",

    // ── Downloads, on a song or a list ───────────────────────────────────────
    "Downloaded": "Badge on something whose files are on the phone",
    "Not available offline": "This one is not downloaded, so it cannot play without a connection",
    "Auto-download": "Keep this playlist downloaded by itself as songs are added to it",
    "Auto-download on": "The toast that says it was turned on",
    "Auto-download off": "The toast that says it was turned off",

    // ── Diagnostics ──────────────────────────────────────────────────────────
    "State": "Section header on the Diagnostics screen: what the app is doing at this moment, as opposed to the timings above it",
    "Counted": "Section header on the Diagnostics screen: things that happened and how many times",
    "Requests": "Section header on the Diagnostics screen: how many times each server endpoint was asked, and how big the answers were",
    "Everything asked of the server, most often first. The music itself is not here: the player opens that connection and this never sees it.": "The line under that header, saying what the list covers and what it leaves out",
    "While minimized": "Section header on the Diagnostics screen, over what was measured with the app in the background rather than on screen. Minimized as in put away: the screen off or another app in front, with the music still going",
    "What happened, rather than how long it took.": "The line under `Counted`: that section is a tally of events, next to the sections above it which are timings",
    "The player keeps beating twice a second while the app is away. Long silences here mean the app stopped following what it was playing.": "The line under `While minimized`. \"The player\" is the native audio engine, not the player screen, and \"beating\" is a heartbeat: it sends its state every 500 ms, and the position, the notification and the move to the next track all hang off that. Everything else on this screen stops measuring once the app is minimized, because the system takes its timers away, so this beat is the one clock still running out there. A long gap means the player itself went quiet, which is a different fault from the app coming back with a stale screen. Keep the medical sense of a pulse if your language has one",

    // ── Odds and ends ────────────────────────────────────────────────────────
    "default": "Lower case on purpose: it goes in brackets after the system font's name, `Roboto (default)`",
    "Rate {n} stars": "Read out by the screen reader for each star. `{n}` is which star it is",
    "Discography": "Everything an artist has released, albums and singles together",
    "Play discography": "Play the lot, in order",
    "Playlist name": "The name field when making or renaming a playlist",
    "Restore default settings": "Put every setting back the way it came",
    "Good morning": "Home's greeting. The hours it changes at are part of the language too, see TRANSLATING.md",
    "Good afternoon": "Home's greeting. The hours it changes at are part of the language too, see TRANSLATING.md",
    "Good evening": "Home's greeting. The hours it changes at are part of the language too, see TRANSLATING.md",
    "Good night": "Home's greeting, for the small hours. Spanish uses the same words as for the evening, which is fine",

    // ── Song information sheet ───────────────────────────────────────────────
    "Year": "Label of a field in the song information sheet: the year of the release",
    "Genre": "Label of a field in the song information sheet",
    "Duration": "Label of a field in the song information sheet: how long the song is",
    "Cover art": "Three places, one word: a section header in Settings › Player, a line of the storage bar in Settings › Downloads, and what the screen reader calls the picture in the song information sheet",

    // ── Songs, favourites and the queue ──────────────────────────────────────
    "Play next": "Action: put this song right after the one playing, without clearing the rest",
    "Playing next": "The toast that says `Play next` worked. Not the same string, and not a heading",
    "Add to queue": "Action: put this song at the end of the queue",
    "Added to queue": "The toast that says it worked",
    "Go to album": "Leave this sheet and open the album the song is on",
    "Go to artist": "Leave this sheet and open the artist",
    "Pin to top": "Keep this at the top of its list, above everything else. `Unpin` undoes it",
    "Unpin": "Stop keeping it at the top of its list",
    "Undo": "The button in a toast that takes back what just happened. It is there for a few seconds",
    "Couldn't complete the action": "What the app says when it does not know what went wrong. Deliberately vague",
    "Now playing": "Heading on the queue screen over the song sounding right now. The player's own label is `NOW PLAYING`, a different string",
    "Next from {name}": "Heading on the queue screen: what is coming, and where it comes from. `{name}` is an album, a playlist or a mix",
    "Stop the mix": "Stop the app carrying on with similar songs when the queue runs out",
    "Mix of “{name}”": "What the player calls the queue once it has grown past its album into songs the app picked itself. `{name}` is the song it was grown from",
    "Mix started": "The toast that says the app is now picking the songs",

    // ── The sleep timer ──────────────────────────────────────────────────────
    "Sleep timer": "Stop playing after a while, for falling asleep to",
    "Sleep timer off": "The toast that says it was turned off",
    "When the song ends": "A value of the sleep timer: stop when this song finishes, however long that is",
    "{n} minutes": "A value of the sleep timer, in minutes from now",

    // ── Sharing and exporting ────────────────────────────────────────────────
    "1 hour": "How long a shared link lasts, counted from the moment it is made. Not a time of day",
    "1 day": "How long a shared link lasts, counted from the moment it is made",
    "1 week": "How long a shared link lasts, counted from the moment it is made",
    "1 month": "How long a shared link lasts, counted from the moment it is made",
    "Couldn't create the link": "The server would not make a share link",
    "Export": "Get the downloaded file itself out of the app, as a file. Not the same as `Share`, which makes a link on the server",
    "Save to a folder": "A value of `Export`: write the file somewhere on the phone",
    "Send to another app": "A value of `Export`: hand the file to another app",
    "Exporting…": "The file is being copied out",
    "Saved as “{name}”": "Where the exported file ended up. `{name}` is the file's name",

    // ── The mode, and what it is called on screen ────────────────────────────
    "Offline": "The toast shown when the app falls into offline mode by itself, and the badge that says it is in it",
    "Back online": "The toast shown when the server answers again and the app comes out of offline mode",
    "Playback stopped": "The mini player when there is nothing playing any more",

    // ── The tabs, and what Android Auto calls them ───────────────────────────
    // These name the tabs at the bottom, the sections inside them, and the
    // folders the car shows, so one word has to work in all three.
    "Home": "The first tab, and a folder in the car",
    "Library": "The settings section, and a folder in the car",
    "Your library": "The tab with your albums, artists and playlists",
    "Search": "The search tab, and the action of searching",
    "Favorites": "The songs, albums and artists you starred",
    "Playlists": "A section on Home and in the library, and a folder in the car",
    "Random albums": "A section of Home: albums picked at random, to happen upon something",
    "Random artists": "A section of Home: artists picked at random",
    "Recently added": "A sort order, and a section: newest first (in Favorites, last favorited first)",
    "Most played": "Sorted by how many times they were played",
    "Most played albums": "A section of Home: the records played most",
    "Most played songs": "A section of Home: the songs played most, as songs",
    "Recently played": "A sort order and a chip: by when they were last played",
    "Suggestions": "Things the app offers when you are picking favourites to pin",

    // ── Home while the phone's own music is being read ───────────────────────
    "Looking for music…": "Reading the phone's own files, before anything can be shown",
    "Loading covers…": "Still pulling the pictures out of the phone's own files",
    "Scanning your music…": "Going through the phone's own files",

    // ── History ──────────────────────────────────────────────────────────────
    "Today": "Heading over the songs played today, on the listening history screen",
    "Yesterday": "Heading over the songs played yesterday",
    "Clear all": "Throw away the whole list: the history, the queue, or what you searched for",

    // ── Settings › Personalization ───────────────────────────────────────────
    "Swipe right": "What dragging a song to the right in a list does. Its values are the actions listed under it",
    "Swipe left": "What dragging a song to the left in a list does",
    "Accent color": "The colour the app uses for buttons, links and anything it wants you to notice",
    "Theme": "The screen where the appearance and the accent colour are chosen, and the name of the row that opens it",
    "Mode": "Heading over the two appearances on the Theme screen. Not a playback mode and not a profile: dark or light. It is called this and not \"Appearance\" because Appearance is the settings screen one level up",
    "Dark": "The appearance the app has always had, and what it uses unless the other is chosen.",
    "Light": "The light appearance, in Settings › Theme",
    "Navigation": "Section header: how you move around the app",
    "Navigation bar": "Settings screen: which tabs are on the bar at the bottom, and in what order",
    "Always shown": "Said where a switch would be, on the Home tab, which cannot be taken off the bar",
    "Explore": "The tab holding everything the server has: all albums, artists, songs, genres, stations and folders",
    "Folder browsing": "Browsing the server's folders as folders, instead of by album and artist",
    "Haptic feedback": "The small vibration when something is tapped",
    "Open the app on": "Which tab the app opens on, and comes back to after a while away",
    "Start on your playlists": "A switch: with it on, Your library with no chip pressed shows the Favorites entry and the playlists, the way it used to, instead of albums, artists and playlists mixed together",
    "Home buttons": "The icons at the top right of Home (search, history, settings), which of them show and in what order",

    // ── Settings › Network ───────────────────────────────────────────────────
    "Server addresses": "Section header: a profile can have several addresses for the same account, one at home and one from outside",
    "Current server address": "The one being used right now, of those",
    "Automatic URL switching": "Try the addresses and use whichever answers, so leaving the house needs nothing done by hand",
    "Add address": "The button. `Add server address` is the title of what it opens",

    // ── Settings › About ─────────────────────────────────────────────────────
    "Version": "Which version of Resonus this is. Tapping it five times opens Diagnostics",
    "What's new": "Opens what changed in this version",
    "Support Resonus": "The row for whoever wants to give something. The app needs nothing to work",

    // ── Radio ────────────────────────────────────────────────────────────────
    "Station name": "The name field when adding an internet radio station",
    "Find a station": "The search box's placeholder on the radio screen",

    // ── Library ──────────────────────────────────────────────────────────────
    "Music": "The name given to the server's folder when it does not have one of its own, browsing by folder",
    "Playlist created": "The toast after making one",

    // ── Settings › Player ────────────────────────────────────────────────────
    "Background": "Section header over what is drawn behind the player. Its two values are `Plain` and `Blurred cover`",
    "Plain": "A value of `Background`: a flat colour behind the player, no picture",
    "Blurred cover": "A value of `Background`: the album art, blurred, behind the player",
    "Lyrics background": "What is drawn behind the lyrics screen, the full screen one",
    "Lyrics card background": "What is drawn behind the small lyrics card that peeks under the player. Not the same thing as `Lyrics background`",
    "Lyrics source": "Where lyrics are looked for. Its values are the three `Prefer…`/`Disable…` lines",
    "Blur inactive lyrics": "A switch in the Lyrics section: progressively softens synchronized lyric rows away from the current line",
    "Slightly blur synchronized lyrics other than the current line to emphasize what is playing.": "Help text under that switch. Only the current synchronized lyric line stays sharp",
    "Prefer local lyrics": "A value of `Lyrics source`: use the ones that came with the file first",
    "Prefer online search": "A value of `Lyrics source`: look them up on the internet first",
    "Disable online search": "A value of `Lyrics source`: only ever use the ones that came with the file",
    "On cover tap": "What tapping the cover art in the player does. One tap and two share the same values, listed below",
    "Nothing": "A value of `On cover tap`: tapping the cover does nothing",
    "Open lyrics screen": "A value of `On cover tap`",
    "Show lyrics on the cover": "A value of `On cover tap`: the lyrics take the cover's place, without leaving the player",
    "Previous button": "What the previous button does when a song is already playing. Its values are the two lines below it",
    "Restart, then previous track": "A value of `Previous button`: the first press goes back to the start of this song, the second to the one before",
    "Always previous track": "A value of `Previous button`: never restarts, always goes back a song",
    "No": "A setting value meaning none or zero, not the answer to a question: no crossfade, no seek buttons",
    "Fit cover art": "Show the whole cover even if it is not square, instead of cropping it to fill",
    "Animated cover background": "A setting: an animated cover (GIF, animated WebP) is shown full screen behind the player instead of inside the square",
    "Scroll long titles": "A title too long to fit slides sideways, over and over, instead of being cut off",
    "Swap favorite and menu": "Exchange the places of those two buttons in the player, for whichever hand you hold the phone in",

    // ── Settings › Quality & playback ────────────────────────────────────────
    "Streaming": "Section header: everything about music coming from the server as it plays",
    "Sound": "Section header: normalization and the pre-amp",
    "Mobile data": "Group header under `Streaming`: the settings that apply on mobile data, as opposed to Wi-Fi",
    "Always": "A value of when a downloaded song is played from the file instead of streamed",
    "On mobile data only": "A value of when a downloaded song is played from the file instead of streamed",
    "Automatic": "A value of `Normalize volume`: let the app decide between per track and per album",
    "Pre-amp": "A gain in decibels applied on top of normalization, for when everything ends up too quiet",
    "Autoplay": "When the queue runs out, keep playing with similar songs instead of stopping",
    "Scrobbling": "Reporting a song as played, to the user's own server and from there to Last.fm or ListenBrainz. The title of its own screen and the row that opens it. The word comes from Last.fm and most languages keep it; use whatever those services call it in yours if they do",
    "How far into a song it counts as played. Whichever of the two comes first.": "At the top of the `Scrobbling` screen, over the two rows below it",
    "Part of the song": "How much of a song must have played before it counts, as a percentage. One of the two scrobble rules, and it can be `Off`",
    "Time played": "How long a song must have played before it counts, as a time. The other scrobble rule, and it can be `Off` too. Whichever of the two comes first is the one that counts",
    "With both off nothing is reported, not even to your own server.": "Shown only when both scrobble rules are `Off`, since that also stops the play counts on the user's own server",
    "Restore defaults": "Button at the end of the `Scrobbling` screen, putting both rules back to what they came as",

    // ── Settings › Downloads & offline ───────────────────────────────────────
    "Downloading": "Section header over the download settings. A heading, not something happening right now",
    "Storage used": "Section header over the bar showing what is taking up room on the phone",
    "Downloads": "In the storage bar: the room the downloaded songs take",
    "Offline library": "In the storage bar: the room the offline copy of the library takes. The same thing the line under it calls `Library metadata copy`, so the two should agree",
    "Local library index": "A line of the storage breakdown: what the app remembers about the phone's own music files. A size, not a setting",
    "Pending changes": "A line of the storage breakdown: favourites and edits made offline, waiting to go up to the server",
    "Radio station art": "A line of the storage breakdown: the pictures of radio stations. A size, not a setting",
    "Automatic offline mode": "Fall into offline mode by itself when the server cannot be reached, and come back when it can",

    // ── Login ────────────────────────────────────────────────────────────────
    "Subsonic server": "The type subtitle under Navidrome's logo, the same kind of line as `Media server`",
    "Music on your device": "Signing in to nothing at all and playing the phone's own files",
    "Choose a folder (recommended)": "One of the two ways to find the phone's own music: point at a folder",
    "Scan the whole phone": "The other way: look everywhere for audio files",
    "Saved profiles": "The accounts already signed in to, to pick one",

    // ── Player ───────────────────────────────────────────────────────────────
    "PLAYING FROM": "Small label above the cover, followed by the name of the album, playlist or mix it is playing from, or by `Queue` while the song is one that was added to the queue by hand. Written in capitals by the design, so it can be capitals in your language too, or not, whichever reads right",
    "NOW PLAYING": "Small label above the cover, in the same place and style as `PLAYING FROM`, when there is nothing to name",
    "Back {n} seconds": "Read out by the screen reader for the seek button. `{n}` is how many seconds it is set to",
    "Forward {n} seconds": "Read out by the screen reader for the seek button. `{n}` is how many seconds it is set to",
    "View queue": "Read out by the screen reader for the button that opens the queue",
    "Server speakers (Jukebox)": "Playing out of the speakers attached to the server itself, rather than the phone. Subsonic calls this jukebox mode",
    "Searching for devices…": "In the output sheet: looking for speakers and TVs to cast to",
    "Add to the group": "Read out by the screen reader, never shown: the + beside a Sonos room in the output sheet, which sets that room playing along with the one already playing. Sonos only, and `group` is a group of SPEAKERS in the sense Sonos itself uses — rooms playing the same thing together. Whatever word Sonos uses in your language is the one",
    "Remove from the group": "The − beside `Add to the group`, and the same in reverse: it takes that room out of the group so it stops playing along. Read out by the screen reader, never shown, and Sonos only",
    "Radio": "Internet radio stations. Most languages keep the word",

    // ── Playlist ─────────────────────────────────────────────────────────────
    "Description": "The playlist's own description: what whoever made it wrote about it",
    "Add an optional description": "Placeholder in the empty description box",
    "Confirm your password": "Changing a cover on the server needs the password again. It is not a new password being set",
    "Wrong password": "The password typed to confirm a cover change was not right",
    "Refresh": "Ask the server for this playlist again, in case it changed elsewhere. Also the button under suggested tracks to regenerate them",
    "Suggested tracks": "Section heading at the bottom of a playlist: songs the server recommends based on what is already in the playlist",
    "Based on the tracks in this playlist": "Subtitle under the suggested tracks heading",
    "Delete": "The confirm button of a delete dialog, for a playlist or a radio station",
    "Updated": "Toast after a change went through",
    "{n} removed from playlist": "`{n}` is a plain number, with no word for songs attached: English reads \"3 removed from playlist\". Put in whatever your language needs around it",
    "Turn on auto-download?": "Asks whether new songs added to this playlist should download by themselves from now on",
    "Turn on": "The confirm button of that question",

    // ── Settings › Library ───────────────────────────────────────────────────
    "Libraries": "Section header over the server's libraries, when it has more than one",
    "Storage": "Section header over the cache",
    "Scan now": "Ask the server to look for new music",
    "Scanning…": "The server is looking for new music right now",
    "Rescanning your music…": "The phone is going through its own files again, offline",
    "Library updated": "Toast after the phone finished going through its own files",
    "Source updated": "Toast after changing where music is read from",
    "{n} items": "How many things the server's scan has found so far",
    "Clear cache": "Throw away what was remembered from the server. Downloads are not touched",

    // ── Diagnostics (Settings › About, tapping the version five times) ───────
    "Measure performance": "Timing, not analytics: how long the app takes to do things on this phone, kept on the phone. Nothing is sent anywhere. It is turned on when somebody is being walked through a slowdown",
    "Measuring is off (Settings › About), so there is nothing to show.": "Empty state on the Diagnostics screen when `Measure performance` has never been switched on",
    "Diagnostics": "The screen's title, and the row in About that opens it",
    "Profile": "Section header over what kind of server the profile is. Not a user profile",
    "Share report": "Button: hands the numbers over as plain text, to paste into an issue",
    "Start over": "Button: clears the measurements and starts counting again. Not \"start playback\"",

    // ── Song information (a song's three-dot menu › the sheet it opens) ──────
    "Song information": "The menu action and the sheet's title: what is known about the track",
    "Track": "The track number on its album. Not the song itself",
    "Format": "The file format (FLAC, MP3…), written as the player writes it",
    "Sample rate": "A property of the audio, in kHz",
    "Channels": "A property of the audio: mono, stereo",
    "BPM": "A property of the audio: beats per minute",
    "Plays": "How many times the song has been played",
    "Rating": "The stars given to the song. Not a bitrate, not a review",
    "Comment": "The file's comment tag, where people keep notes about a recording",
    "Moods": "Mood tags the server has on the song: mellow, energetic…",
    "Content": "Label of the parental advisory row: whether the recording is explicit. Not the song's lyrics, not what it is about",
    "Explicit": "A value of `Content`: the recording carries a parental advisory (strong language). Also read out for the E badge next to a title",
    "Clean": "A value of `Content`: the edited version, with the explicit language taken out. Not \"tidy\" and not \"free of noise\"",
    "This song carries no information.": "Empty state: the file and the server had nothing to say",

    // ── Sharing a link (the sheet that opens on Share) ───────────────────────
    "Share “{name}”": "The sheet's title, with what is being shared",
    "The link expires in": "Heading over the choices below. They are spans from the moment the link is made, not times of day",
    "Never": "A value of `Play downloaded songs from the phone`: always stream, never use the file on the phone. The share sheet's own \"never expires\" is a separate key, `Never::expiry`, so a language that needs two different words can have them",
    "Never::expiry": "Under `The link expires in`: the shared link never stops working. Its own key, so it need not be the same word as `Never` in the playback settings",
    "Pick a date…": "Opens the calendar to choose the day the link stops working",
    "Allow downloads": "Whether whoever gets the link can download the music, not only listen to it",
    "Server didn't allow downloads": "Warning after sharing: the link was made and works, but the call that turns downloading on did not go through",

    // ── Browsing songs (Home › the Songs chip) ───────────────────────────────
    "Songs": "Always a heading, never a count, so it wants the plain plural your language uses for a list of them (\"Songs\", not \"of songs\"). Counting songs is a different thing and goes through the plural forms",
    "Default": "Sorting pill: what you get when nothing is sorted, which is the order the server keeps its songs in. Not alphabetical, and not Resonus deciding. On a playlist it is the order the list came in, which is the one you made by dragging the songs if it is an ordinary playlist and the one its rules produced if it is a smart one — hence a word that is true of both rather than \"custom\" or \"pre-defined\"",
    "Find a playlist": "The search box's placeholder on that screen",
    "Find a song": "The search box's placeholder on that screen",
    "No songs yet": "Empty state when the library has no songs",
    "Your recently played songs will show up here.": "Empty state, before anything has been played",
    "Your most played songs will show up here.": "Empty state, before anything has been played",

    // ── Other ────────────────────────────────────────────────────────────────
    "Show description": "A setting: whether playlist and album descriptions are drawn under their names on their screens",
    "Playlist covers": "One line of the storage breakdown in Settings › Downloads: how much room the playlist cover images take. It is a size, not a setting",
    "Free": "Free disk space in the storage bar (Other / Downloads / Free). Not \"free of charge\"",
    "Other": "Two places, and the same word does for both: in that storage bar, the space used by things other than downloads; and on an artist's page, the last shelf of the discography, holding the records that fit none of the kinds above it",
    "Library metadata copy": "The offline copy of the library: the album, artist and playlist lists kept so the app works with no connection. Not the songs themselves, which are the downloads",
    "Nothing here is downloaded": "Toast when playing something that is not downloaded, offline",
    "Try exploring another genre.": "Empty state subtitle on a genre screen",
    "Unknown artist": "Fallback when the file and the server have no artist",
    "Unknown album": "Fallback when the file and the server have no album",
    "Unknown title": "Fallback when the file and the server have no title",

    // ── Updating the app itself ──────────────────────────────────────────────
    "Update": "The button that installs a newer version of Resonus. A verb, not a noun: `Update it`, not `An update`",
    "Check for updates": "Ask GitHub now whether a newer Resonus is out",
    "You're on the latest version": "Answer when that check finds nothing newer",
    "Installing updates needs permission": "Shown when the user came back from Android's «install unknown apps» screen without granting it"
  },

  // ── Custom font ────────────────────────────────────────────────────────
  "Couldn't load the font": "Toast when the chosen file could not be loaded as a font",
  "Make sure the file is a valid .ttf or .otf font.": "Line under that toast, explaining what might be wrong",
  "Loaded": "Toast after a custom font was loaded successfully",
  "Load a .ttf or .otf file": "Button on the font picker screen to import a custom font file",
  "Active": "Label showing which custom font is currently applied",
  "Remove custom font": "Button to remove the custom font and fall back to the system one",

  // ── Personalization (Settings › Player, Song lists, Theme) ──────────────
  "Favorite": "One of the choices for the button next to play on the mini player: the heart. Not a verb",
  "None": "One of the choices for the buttons next to play on the mini player: no button at all",
  "Cover corners": "The corners of every cover art picture in the app, whose choices are Square, Rounded and More rounded",
  "Square": "Corners of the cover art: sharp, not rounded at all",
  "Rounded": "Corners of the cover art: slightly rounded, the usual look",
  "More rounded": "Corners of the cover art: rounder than the usual",
  "Lyrics size": "A slider for text size on every lyrics surface, from 20 to 40",
  "Lyrics weight": "Thickness of text on every lyrics surface",
  "Light font weight": "A lyrics font weight: thin strokes (300)",
  "Regular font weight": "A lyrics font weight: regular strokes (400)",
  "Medium font weight": "A lyrics font weight: medium strokes and the default (500)",
  "Semi-bold font weight": "A lyrics font weight: semi-bold strokes (600)",
  "Bold font weight": "A lyrics font weight: bold strokes (700)",
  "Left": "Lyrics alignment: lines start at the left edge",
  "Centered": "Lyrics alignment: each line centred",
  "Scheduled": "A theme mode: light from one hour of the day, dark from another",
  "Light from": "With the scheduled theme, the hour light starts. Followed by a time such as 07:00",
  "Dark from": "With the scheduled theme, the hour dark starts. Followed by a time such as 21:00",

  // ── Home sections ──────────────────────────────────────────────────────
  "Random songs": "A section of Home: songs picked at random from the library",

  // ── Podcasts ───────────────────────────────────────────────────────────
  "Podcasts": "Shows you subscribe to on this phone, played from the address the publisher gives. Not something the music server stores",
  "Episodes": "One episode of a podcast, as listed on the show's screen",
  "Subscribe": "Button that adds a podcast to your list. Not to an event or a newsletter",
  "Unsubscribe": "Removes a podcast and its episodes from this phone",
  "Play latest": "Button on a podcast's screen: starts the newest episode. It does not resume where you left off",
  "No audio available": "An episode listed with nothing to play, because the feed gave no file for it",
  "Open website": "Opens the podcast's own web page in the browser, not the feed file",
  "Untitled episode": "An episode the feed gave no name to",

  // Strings that are meant to stay in English, and are not counted as missing.
  //
  // Empty for now. The Diagnostics measurements used to be listed here, and
  // translators translated them anyway, so they no longer go through `t()` at
  // all: see `src/app/settings/diagnostics.tsx`.
  "keepEnglish": []
}
