{
  "expo": {
    "name": "Resonus",
    "slug": "resonus",
    "version": "0.7.4",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "resonus",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.juananzzz.resonus",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.juananzzz.resonus",
      "versionCode": 45,
      "adaptiveIcon": {
        "backgroundColor": "#1CD667",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withReleaseSigning",
      "./plugins/withoutFontWeightAdjustment",
      "./plugins/withTrimmedPermissions",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 1,
          "android": {
            "backgroundColor": "#121212",
            "image": "./assets/images/splash-blank.png",
            "imageWidth": 1
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "audio"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-asset",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a86dcb07-c2d9-4932-93aa-e07f6ecf1e3b"
      }
    }
  }
}
